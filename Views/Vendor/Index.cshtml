@{
    ViewBag.Title = "Index";
    // Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
    // older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
    // instead of silently keeping stale styling until a manual hard refresh.
    var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">*@
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>*@
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>*@
<script src="~/Scripts/form-validation.js"></script>

<script>
    $(document).ready(function () {

        $("#VendorName").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetSearchValue","Vendor")',
                    dataType: "json",
                    data: { search: $("#VendorName").val() },
                    success: function (data) {

                        response($.map(data, function (item) {
                            return { label: item, value: item };
                        }));
                    },
                    error: function (xhr, status, error) {
                        alert("Error");
                    }
                });
            }
        });
    });

    function LoadData() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetVendor", "Vendor")',
            dataType: 'json',
            data: { vendorName: $('#VendorName').val() },
            success: function (data) {
                if (data == 'Not Found') {
                    alert('Vendor Not found');
                }
                else {
                    $('#VendorName').val(data.VendorName);
                    $('#Address').val(data.Address);
                    $('#ContactPerson').val(data.ContactPerson);
                    $('#ContactNumber').val(data.ContactNumber);
                    $('#Email').val(data.Email);
                    $('#GST').val(data.GST);
                    $('#IsActive').val(data.IsActive);
                    $('#VendorType').val(data.VendorType);
					$('#VendorMSME').val(data.VendorMSME);
                }

            },
            error: function (ex) {
                alert('Vendor Not Found');
                console.log(ex);
            }

        });
    }
    function ShowSaveSuccess() {
        $("#message").text('Record Saved Successfully');
        alert('Record Saved Successfully');
        setTimeout(function () { $("#message").hide(); }, 5000);
        $('#errormessage').html('');
    }
    function AddData() {
         //$('#btnSave').prop('disabled', false);
        $('#VendorName').val('');
        $('#Address').val('');
        $('#ContactPerson').val('');
        $('#ContactNumber').val('');
        $('#Email').val('');
        $('#GST').val('');
        $('#VendorMSME').val('');
    }
    function SaveData() {

        if (ValidateForm() == false) {
            return false;
        }
        //Serialize the form datas.
        var valdata = $("#VendorForm").serialize();
        //to get alert popup
        $.ajax({
            url: '@Url.Action("SaveVendor","Vendor")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data.Result.includes == "Error") {
                    alert(data.Result);
                }
                else {
                    ShowSaveSuccess(data.Result);
                }
            },
            error: function (ex) {
                console.log(ex);
            }
        });
    //ShowSaveSuccess();
    //$('#btnSave').prop('disabled', true);
    }

    function ValidateForm() {

	    var message = "";

        if ($('#VendorName').val() == "")
        {
            message += 'Vendor Name' + '<br>';
        }
        if ($('#ContactPerson').val() == "")
        {
            message += 'Contact Person' + '<br>';
        }
        if ($('#Address').val() == "")
        {
            message += 'Address' + '<br>';
        }
        if ($('#ContactNumber').val()=="")
        {
            message += 'Contact Number' + '<br>';
        }
        //if ($('#Email').val() == "")
        //{
        //    message += 'Email' + '<br>';
        //}
        if ($('#IsActive').val() == "") {
            message += 'IsActive' + '<br>';
        }
        if ($('#VendorType').val() == "") {
            message += 'Vendor Type' + '<br>';
        }
        if (message != "") {
            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {
            $('#errormessage').html('');
        }
        return true;
    }

    function ShowSaveSuccess(res) {
        $("#message").text(res);
        alert(res);
        setTimeout(function () { $("#message").hide(); }, 5000);
    }

</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-briefcase"></span>Vendor Management
    </div>

    <form role="form" name="VendorForm" id="VendorForm" autocomplete="off">

        <!-- ================= Search Existing Vendor ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-search"></span>Find Existing Vendor</div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="VendorName" class="form-label">Vendor Name</label>
                        <div class="input-group">
                            <input type="text" id="VendorName" name="VendorName" autocomplete="off" placeholder="Start typing a vendor name..." class="form-control ui-input-md">
                            <span class="input-group-btn">
                                <button class="btn btn-info" type="button" onclick="LoadData();" title="Load this vendor">
                                    <span class="glyphicon glyphicon-search"></span>Load
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" id="btnAdd" name="btnAdd" class="btn btn-default" onclick="AddData();" title="Clear the form and start a new vendor">
                            <span class="glyphicon glyphicon-plus"></span>New Vendor
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Vendor Details ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-list-alt"></span>Vendor Details</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Address" class="form-label required">Address</label>
                        <input type="text" id="Address" name="Address" placeholder="Address" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ContactPerson" class="form-label required">Contact Person</label>
                        <input type="text" id="ContactPerson" name="ContactPerson" placeholder="Contact Person" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ContactNumber" class="form-label required">Contact Number</label>
                        <input type="tel" id="ContactNumber" name="ContactNumber" placeholder="Contact Number" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Email" class="form-label">Email</label>
                        <input type="email" id="Email" name="Email" placeholder="Email" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="GST" class="form-label">GST</label>
                        <input type="text" id="GST" name="GST" placeholder="GST Number" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="IsActive" class="form-label required">Active</label>
                        <select name="IsActive" id="IsActive" class="form-control">
                            <option value="">--Select--</option>
                            <option value="yes">yes</option>
                            <option value="no">no</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="VendorType" class="form-label required">Vendor Type</label>
                        <select name="VendorType" id="VendorType" class="form-control">
                            <option value="">--Select--</option>
                            <option value="PO">PO Vendor</option>
                            <option value="Challan">Outgoing Challan Vendor</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="VendorMSME" class="form-label">Vendor MSME</label>
                        <input type="text" id="VendorMSME" name="VendorMSME" placeholder="Vendor MSME" class="form-control">
                    </div>
                </div>
            </div>

            <!-- ================= Save (kept in this card, alongside the fields it saves) ================= -->
            <div class="row ui-card-footer">
                <div class="col-md-6">
                    <div id="message" name="message"></div>
                </div>
                <div class="col-md-6 btn-toolbar-right">
                    <button type="button" id="btnSave" name="btnSave" class="btn btn-primary" onclick="SaveData();">
                        <span class="glyphicon glyphicon-floppy-disk"></span>Save Vendor
                    </button>
                </div>
            </div>
            <div id="errormessage"></div>
        </div>

    </form> <!-- /VendorForm -->
</div> <!-- ./container -->
