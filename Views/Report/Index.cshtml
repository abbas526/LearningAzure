@{
    ViewBag.Title = "Index";
    // Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
    // older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
    // instead of silently keeping stale styling until a manual hard refresh.
    var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>
<script src="~/Scripts/form-validation.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

      $.ajax({
           type: "GET",
           url: '@Url.Action("GetProjectNames","PurchaseRequisition")',
           success: function (data) {
               var s = '<option value="">--Select--</option>';
               for (var i = 0; i < data.length; i++) {
                   s += '<option value="' + data[i] + '">' + data[i] + '</option>';
               }
               $("#ProjectNameDropdown").html(s);
           }
      });

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetVendorNames", "BillPayment")',
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#VendorBills").html(s);
            }
        });


        @*$('#btnDownloadDB').click(function () {
            var url = '@Url.Action("DownloadDB", "Report")';
            var SuperAdminCode = $('#SuperAdminCode').val();
            window.location.href = url;
        });*@

        $('#btnExportPR').click(function () {
            var url = '@Url.Action("WritePRToExcel", "Report")';
            var SuperAdminCode = $('#SuperAdminCode').val();
            var startDate = $('#PRStartDate').val();
            var endDate = $('#PREndDate').val();
            window.location.href = url + '?PRStartDate=' + startDate + "&PREndDate=" + endDate;
        });
        $('#btnExportPendingPR').click(function () {
            var url = '@Url.Action("WritePendingPRToExcel", "Report")';
            var SuperAdminCode = $('#SuperAdminCode').val();
            window.location.href = url;
        });
        $('#btnExportPO').click(function () {
            var url = '@Url.Action("WritePOToExcel", "Report")';
            var SuperAdminCode = $('#SuperAdminCode').val();
            //alert($('#SuperAdminCode').val());
            var startDate = $('#POStartDate').val();
            var endDate = $('#POEndDate').val();
            //alert(url + '?PRStartDate=' + startDate + "&PREndDate=" + endDate + "&Code=" + SuperAdminCode);
            window.location.href = url + '?POStartDate=' + startDate + "&POEndDate=" + endDate;
        });
        $('#btnExportPOItem').click(function () {
            var url = '@Url.Action("WritePOItemToExcel", "Report")';
            var startDate = $('#POItemStartDate').val();
            var endDate = $('#POItemEndDate').val();
            window.location.href = url + '?POStartDate=' + startDate + "&POEndDate=" + endDate;
        });
        $('#btnExportVendor').click(function () {
            var url = '@Url.Action("WriteVendorToExcel", "Report")';
            window.location.href = url;
        });
        $('#btnExportPODetails').click(function () {
			var url = '@Url.Action("WritePOForProjectToExcel", "Report")';

			var projectname = $('#ProjectNameDropdown').val();
			// Replace '&' with '||' in the project name
			var modifiedProjectName = projectname.replace(/&/g, '||');

			window.location.href = url + '?ProjectName=' + encodeURIComponent(modifiedProjectName);

            //window.location.href = url + '?ProjectName=' + projectname;
        });
        $('#btnExportChallan').click(function () {
            var url = '@Url.Action("WriteChallanToExcel", "Report")';
			var projectname = $('#ProjectNameDropdown').val();

			// Replace '&' with '||' in the project name
			var modifiedProjectName = projectname.replace(/&/g, '||');

			window.location.href = url + '?ProjectName=' + encodeURIComponent(modifiedProjectName);
		});
		$('#btnExportBills').click(function () {
            var url = '@Url.Action("WriteVendorBillsToExcel", "Report")';
            var vendor = $('#VendorBills').val();
			window.location.href = url + '?Vendor=' + vendor;
        });
		
    });
    // Clears just this card's date-range fields, so a report can be pulled for "all time"
    // without needing a Start/End Date filled in.
    function ResetPRDates() {
        $('#PRStartDate').val('');
        $('#PREndDate').val('');
    }
    function ResetPODates() {
        $('#POStartDate').val('');
        $('#POEndDate').val('');
    }
    function ResetPOItemDates() {
        $('#POItemStartDate').val('');
        $('#POItemEndDate').val('');
    }

    function ValidatePassword() {
            //Serialize the form datas.
            var valdata = { "Pass": $("#SuperAdminCode").val() };
            //to get alert popup
            $.ajax({
                url: '@Url.Action("ValidatePassword", "Report")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data == 'Success') {

                        $('#btnExportPR').attr("disabled", false);
                        $('#btnExportPR').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportPO').attr("disabled", false);
                        $('#btnExportPO').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportPOItem').attr("disabled", false);
                        $('#btnExportPOItem').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportVendor').attr("disabled", false);
                        $('#btnExportVendor').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportPendingPR').attr("disabled", false);
                        $('#btnExportPendingPR').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportPODetails').attr("disabled", false);
                        $('#btnExportPODetails').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        $('#btnExportChallan').attr("disabled", false);
						$('#btnExportChallan').css({ backgroundColor: '#0078D4', color: '#ffffff' });
						$('#btnExportBills').attr("disabled", false);
						$('#btnExportBills').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                        //$('#btnDownloadDB').attr("disabled", false);
                        //$('#btnDownloadDB').css({ backgroundColor: '#0078D4', color: '#ffffff' });
                    }


                    else {
                        alert('Fail. Enter Valid Password.');
                        $('#btnExportPR').attr("disabled", true);
                        $('#btnExportPR').css({ backgroundColor: 'red' });
                        $('#btnExportPO').attr("disabled", true);
                        $('#btnExportPO').css({ backgroundColor: 'red' });
                        $('#btnExportPOItem').attr("disabled", true);
                        $('#btnExportPOItem').css({ backgroundColor: 'red' });
                        $('#btnExportVendor').attr("disabled", true);
                        $('#btnExportVendor').css({ backgroundColor: 'red' });
                        $('#btnExportPendingPR').attr("disabled", true);
                        $('#btnExportPendingPR').css({ backgroundColor: 'red' });
                        $('#btnExportPODetails').attr("disabled", true);
                        $('#btnExportPODetails').css({ backgroundColor: 'red' });
                        $('#btnExportChallan').attr("disabled", true);
						$('#btnExportChallan').css({ backgroundColor: 'red' });
						$('#btnExportBills').attr("disabled", true);
						$('#btnExportBills').css({ backgroundColor: 'red' });
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
    }

</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-cloud-download"></span>Data Export &amp; Reports
    </div>

    <form role="form" name="PRForm" id="PRForm" autocomplete="off">

        <!-- ================= Access Code ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-lock"></span>Access Code</div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="SuperAdminCode" class="form-label required">SuperAdmin Code</label>
                        <input type="password" id="SuperAdminCode" name="SuperAdminCode" placeholder="Super Admin Code" class="form-control ui-input-sm" maxlength="4" autocomplete="new-password">
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" id="btnCheckCode" name="btnCheckCode" class="btn btn-info" onclick="ValidatePassword();">
                            <span class="glyphicon glyphicon-ok"></span>Validate Code
                        </button>
                    </div>
                </div>
            </div>
            <div class="ui-error mb-0">All exports below stay disabled until a valid SuperAdmin Code is entered here.</div>
        </div>

        <!-- ================= Purchase Requisitions ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title" style="display:flex; align-items:center; justify-content:space-between;">
                <span><span class="glyphicon glyphicon-list-alt"></span>Purchase Requisitions</span>
                <button type="button" class="btn btn-default btn-xs" onclick="ResetPRDates();" title="Clear the date range so this report can be exported without a date filter">
                    <span class="glyphicon glyphicon-refresh"></span>Reset Dates
                </button>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="PRStartDate" class="form-label">PR Start Date</label>
                        <input type="date" id="PRStartDate" name="PRStartDate" placeholder="PR Start Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="PREndDate" class="form-label">PR End Date</label>
                        <input type="date" id="PREndDate" name="PREndDate" placeholder="PR End Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportPR" name="btnExportPR" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export PR
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Purchase Orders ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title" style="display:flex; align-items:center; justify-content:space-between;">
                <span><span class="glyphicon glyphicon-shopping-cart"></span>Purchase Orders</span>
                <button type="button" class="btn btn-default btn-xs" onclick="ResetPODates();" title="Clear the date range so this report can be exported without a date filter">
                    <span class="glyphicon glyphicon-refresh"></span>Reset Dates
                </button>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="POStartDate" class="form-label">PO Start Date</label>
                        <input type="date" id="POStartDate" name="POStartDate" placeholder="PO Start Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="POEndDate" class="form-label">PO End Date</label>
                        <input type="date" id="POEndDate" name="POEndDate" placeholder="PO End Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportPO" name="btnExportPO" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export PO
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Purchase Order Items ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title" style="display:flex; align-items:center; justify-content:space-between;">
                <span><span class="glyphicon glyphicon-th-list"></span>Purchase Order Items</span>
                <button type="button" class="btn btn-default btn-xs" onclick="ResetPOItemDates();" title="Clear the date range so this report can be exported without a date filter">
                    <span class="glyphicon glyphicon-refresh"></span>Reset Dates
                </button>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="POItemStartDate" class="form-label">PO Start Date</label>
                        <input type="date" id="POItemStartDate" name="POItemStartDate" placeholder="PO Start Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="POItemEndDate" class="form-label">PO End Date</label>
                        <input type="date" id="POItemEndDate" name="POItemEndDate" placeholder="PO End Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportPOItem" name="btnExportPOItem" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export PO Items
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Project Exports (PO Details / Outgoing Challan) ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-folder-open"></span>Project Exports</div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="ProjectNameDropdown" class="form-label">Project Name</label>
                        <select class="form-control" id="ProjectNameDropdown" name="ProjectNameDropdown"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportPODetails" name="btnExportPODetails" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export PO Details
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportChallan" name="btnExportChallan" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export Challan Details
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Vendor Bills ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-usd"></span>Vendor Bills</div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="VendorBills" class="form-label">Vendor</label>
                        <select class="form-control" id="VendorBills" name="VendorBills"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" disabled="disabled" id="btnExportBills" name="btnExportBills" class="btn btn-default btn-block">
                            <span class="glyphicon glyphicon-download-alt"></span>Export Bills
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Other Exports ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-list"></span>Other Exports</div>
            <div class="row">
                <div class="col-md-6">
                    <button type="button" disabled="disabled" id="btnExportVendor" name="btnExportVendor" class="btn btn-default btn-block">
                        <span class="glyphicon glyphicon-download-alt"></span>Export Vendor Details
                    </button>
                </div>
                <div class="col-md-6">
                    <button type="button" disabled="disabled" id="btnExportPendingPR" name="btnExportPendingPR" class="btn btn-default btn-block">
                        <span class="glyphicon glyphicon-download-alt"></span>Export Pending PR Details
                    </button>
                </div>
            </div>
			@*<div class="row mt-3">
				<div class="col-md-6">
					<button type="button" disabled="disabled" id="btnDownloadDB" name="btnDownloadDB" class="btn btn-default btn-block">
						<span class="glyphicon glyphicon-download-alt"></span>Download Database
					</button>
				</div>
			</div>*@
        </div>

        <div id="errormessage" class="ui-error"><span></span></div>

	</form> <!-- /PRForm -->

</div> <!-- ./container -->
