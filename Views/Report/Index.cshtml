				<input class="col-sm-2" disabled="disabled" type="button" id="btnExportPO" name="btnExportPO" value="Export PO" />
			</div>
		</div>
		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Purchase Order Items</label>
				<div class="col-sm-3">
					<input type="date" id="POItemStartDate" required="required" name="POItemStartDate" placeholder="PO Start Date" class="form-control">
				</div>
				<div class="col-sm-3">
					<input type="date" id="POItemEndDate" required="required" name="POItemEndDate" placeholder="PO End Date" class="form-control">
				</div>
				<input class="col-sm-2" disabled="disabled" type="button" id="btnExportPOItem" name="btnExportPOItem" value="Export PO ITems" />
			</div>
		</div>
		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Vendors</label>
				<div class="col-sm-3">
					<input class="col-sm-8" disabled="disabled" type="button" id="btnExportVendor" name="btnExportVendor" value="Export Vendor Details" />
				</div>
				<div class="col-sm-3">
					&nbsp;
				</div>
				&nbsp;
			</div>
		</div>
		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Pending PR List</label>
				<div class="col-sm-3">
					<input class="col-sm-8" disabled="disabled" type="button" id="btnExportPendingPR" name="btnExportPendingPR" value="Export Pending PR Details" />
				</div>
				<div class="col-sm-3">
					&nbsp;
				</div>
				&nbsp;
			</div>
		</div>
		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Project Names</label>
				<div class="col-sm-3">
					<select class="form-control" id="ProjectNameDropdown" name="ProjectNameDropdown"></select>
				</div>
				<div class="col-sm-3">
					<input class="col-sm-8" disabled="disabled" type="button" id="btnExportPODetails" name="btnExportPODetails" value="Export PO Details" />
				</div>
				<div class="col-sm-3">
					&nbsp;
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Outgoing Challan List</label>
				<div class="col-sm-3">
					<input class="col-sm-8" disabled="disabled" type="button" id="btnExportChallan" name="btnExportChallan" value="Export Challan Details" />
				</div>
				<div class="col-sm-3">
					&nbsp;
				</div>
				&nbsp;
			</div>
		</div>

		<div class="row">
			<div class="form-group col-md-12">
				<label for="PR" class="col-sm-3 control-label">Vendors</label>
				<div class="col-sm-3">
					<select class="form-control" id="VendorBills" name="VendorBills"></select>
				</div>
				<div class="col-sm-3">
					<input class="col-sm-8" disabled="disabled" type="button" id="btnExportBills" name="btnExportBills" value="Export Bills" />
				</div>
				<div class="col-sm-3">
					&nbsp;
				</div>
			</div>
		</div>
