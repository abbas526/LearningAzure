@{
    ViewBag.Title = "Index";
    // Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
    // older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
    // instead of silently keeping stale styling until a manual hard refresh.
    var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>
<script src="~/Scripts/form-validation.js"></script>

<script>
    $(document).ready(function () {
     $.ajax({
           type: "GET",
           url: '@Url.Action("GetItemNames","PurchaseRequisition")',
           success: function (data) {
               var s = '<option value="">--Select--</option>';
               for (var i = 0; i < data.length; i++) {
                   s += '<option value="' + data[i] + '">' + data[i] + '</option>';
               }
               $("#ItemDropdown").html(s);
           }
     });
    });
    function ValidateForm() {

        var message = "";

        if ($('#ItemName').val() == "") {
            message += 'Item Name' + '<br>';
        }
        if (message != "") {
            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {
            $('#errormessage').html('');
        }
        return true;
    }
    function ClearScreen() {

    }
   function SaveData() {

        if (ValidateForm() == false) {
            return false;
        }
            //Serialize the form datas.
            var valdata = $("#ItemForm").serialize();
            //to get alert popup
            $.ajax({
                url: '@Url.Action("SaveItem","Item")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data.Result.includes('Error')) {
                        alert(data.Result);
                    }
                    else {
                        ShowSaveSuccess(data.Result);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });

    }

    function ShowSaveSuccess() {
        $("#message").text('Record Saved Successfully');
        alert('Record Saved Successfully');
        setTimeout(function () { $("#message").hide(); }, 5000);
        $('#errormessage').html('');
    }
</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-tags"></span>Item Management
    </div>

    <form role="form" name="ItemForm" id="ItemForm" autocomplete="off">

        <!-- ================= Add New Item ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-plus"></span>Add New Item</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ItemName" class="form-label required">New Item Name</label>
                        <input type="text" id="ItemName" name="ItemName" placeholder="Item Name" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row ui-card-footer">
                <div class="col-md-6">
                    <div id="message" name="message"></div>
                </div>
                <div class="col-md-6 btn-toolbar-right">
                    <button type="button" id="btnSave" name="btnSave" class="btn btn-primary" onclick="SaveData();">
                        <span class="glyphicon glyphicon-floppy-disk"></span>Save Item
                    </button>
                </div>
            </div>
            <div id="errormessage"></div>
        </div>

        <!-- ================= Existing Items ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-list-alt"></span>Existing Items</div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label for="ItemDropdown" class="form-label">Existing Items List</label>
                        <select class="form-control" id="ItemDropdown" name="ItemDropdown"></select>
                    </div>
                </div>
            </div>
        </div>

    </form> <!-- /ItemForm -->
</div> <!-- ./container -->
