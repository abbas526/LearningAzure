@{
	ViewBag.Title = "Index";
	// Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
	// older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
	// instead of silently keeping stale styling until a manual hard refresh.
	var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>

<script src="~/Scripts/form-validation.js"></script>

<script>
    var Id = 0;
    var ProjectNames;
    var Balance = 0;
	var selectedValues = [];
    $(document).ready(function () {

        $("#Vendor").change(function () {

            $('#ChallanNo').empty();
			$('#PaymentListTable tbody').empty();
			$('#VendorTable tbody').empty();
			$('#PendingBillTable  tbody').empty();
			ClearBillScreen();
			ClearPaymentScreen();
            var selectedValue = $(this).val();

            $.ajax({
                url: '/BillPayment/GetChallanNumbers',
                type: 'GET',
                dataType: 'json',
                data: { vendor: selectedValue },
                success: function (data) {
                    var challanNo = $("#ChallanNo");
					challanNo.empty();
					if (data.includes('Note:')) {
						$('#errorMessageForList').html(data);
					}
					else {
						$.each(data, function (index, item) {
							challanNo.append('<option value="' + item + '">' + item + '</option>');
						});
					}
                },
                error: function (error) {
                    console.log(error);
                }
            });
			LoadPendingBillData();

			PaymentDetails();
        });


        $.ajax({
            type: "GET",
            url: '@Url.Action("GetVendorNames", "BillPayment")',
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#Vendor").html(s);
            }
        });
        $('#BillDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#PaymentDate').datepicker({
            dateFormat: "dd-mm-yy",
        });

         // If full payment is selected then display the total in the payment textbox
		$('#PendingBillTable').on('change', '.row-checkbox', function () {
			updateTotalAmount();
		});

		function updateTotalAmount() {
			// Get all checked checkboxes and sum their corresponding row amounts
			var totalAmount = 0;
			$('.row-checkbox:checked').each(function () {
				var row = $(this).closest('tr');
				var amount = parseFloat(row.find('td:eq(2)').text());
				if (!isNaN(amount)) {
					totalAmount += amount;
				}
			});

			// Display the total amount in the input field
			$('#PaymentAmount').val(totalAmount.toFixed(2));


		}

		$('#btnExportBills').click(function () {
            var url = '@Url.Action("WriteVendorBillsToExcel", "Report")';
            //var vendor = $('#VendorBills').val();
			window.location.href = url + '?Vendor=';
        });

    });



   function BillSave() {
            //Serialize the form data.
        if (ValidateBillForm() == false) { return false; }

       //$("#ChallanNoList").val(JSON.stringify(selectedValues));
	   $("#ChallanNoList").val(selectedValues.join(','));
        var valdata = $("#BillForm").serialize();
        // Save PO
        $.ajax({
            url: '@Url.Action("BillSave", "BillPayment")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                console.debug(data);
				if (data != 'Success') {
					alert(data);
                }
                else {
					alert('Saved Successfully');
					$('#errorMessageForList').html("<b>Saved Successfully</b>");
					setTimeout(function () { $("#errorMessageForList").hide(); }, 5000);

					BillAddToTable($('#BillNo').val(), $('#BillDate').val(), $('#BillAmount').val(), $('#Company').val());
					$("#btnPaymentSave").prop("disabled", false);
					$("#ClearPaymentButton").prop("disabled", false);
					$('#errorMessageForPayment').html("");
                }
            },
            failure: function (response) {
                alert("Error");
            }
        });

    }

	function PaymentSaveNew() {
		if (ValidatePaymentForm() == false) { return false; }
			// Collect data from plain text fields
		var formData = {
				Vendor: $('#Vendor').val(),
				PaymentAmount: $('#PaymentAmount').val(),
				PaymentDate: $('#PaymentDate').val(),
				OnlineRefNo: $('#OnlinePaymentRefNo').val(),
				ChequeNumber: $('#ChequeNo').val(),
			};

			// Collect data from the table
			formData.BillDetails = [];
		$('#PendingBillTable tbody tr').each(function () {
				var billNo = $(this).find('td:eq(0)').text();
				var amount = $(this).find('td:eq(2)').text();
				var paymentDone = $(this).find('td:eq(4) input[type="checkbox"]').prop('checked');
				var fullPaymentDone = $(this).find('td:eq(5) input[type="checkbox"]').prop('checked');
				if (paymentDone) {
					formData.BillDetails.push({
						BillNo: billNo,
						FullPaymentDone: fullPaymentDone,
						Amount: amount
					});
				}
			});
		if (formData.BillDetails === null || formData.BillDetails.length === 0)
			{
				$('#errorMessageForPayment').html("*Please select Bills against which payment is being made");
				return false;
			}
			// Send data to the controller using Ajax
			$.ajax({
				url: '/BillPayment/BillPaymentNewSave',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function (result) {
					console.debug(result);
					if (result != 'Success') {
						alert(result);
					}
					else {
						alert('Saved Successfully');
						$('#errorMessageForPayment').html("<b>Payment against Bill is saved successfully</b>");
						setTimeout(function () { $("#errorMessageForPayment").hide(); }, 5000);

						$("#PendingBillTable tbody tr").each(function () {
							// Check if the checkbox in the 5th column is checked
							if ($(this).find("td:eq(" + 4 + ") input[type='checkbox']").prop("checked")) {
								// If checked, clear the row
								$(this).empty();
							}
						});
						PaymentDetails();
						ClearPaymentScreen();
					}
				},
				error: function (error) {
					// Handle error
				}
			});
	}
    function ValidateBillForm() {

		var message = "";
		if ($('#Vendor').val() == "") {
			message += 'Vendor' + '<br>';
        }
		if (selectedValues.length == 0) {
			message += 'Challan Number' + '<br>';
		}
		if ($('#BillNo').val() == "") {
			message += 'Bill Number' + '<br>';
		}
		if ($('#BillDate').val() == "") {
			message += 'Bill Date' + '<br>';
		}
		if ($('#BillAmount').val() == "") {
			message += 'BillAmount' + '<br>';
		}
		if ($('#Company').val() == "") {
			message += 'Company' + '<br>';
		}
		if (message != "") {

			$('#errorMessageForList').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
			return false;
		}

		console.log($('#PaymentAmount').val());
		console.log(Balance);
		if (parseFloat($('#PaymentAmount').val()) > parseFloat(Balance)) {
			$('#errormessage').html("* <b> Payment Amount should not exceed Balance</b><br>");
			return false;
		}
		$('#errormessage').html("");
		return true;
	}
	function ValidatePaymentForm() {
		var totalAmount = 0;
		$('.row-bill-selected:checked').each(function () {
			var row = $(this).closest('tr');
			var amount = parseFloat(row.find('td:eq(2)').text());
			if (!isNaN(amount)) {
				totalAmount += amount;
			}
		});

		// Get the current value of the total amount input field
		var currentTotal = parseFloat($('#PaymentAmount').val());

		// Validate and update the total amount in the input field
		totalAmount = parseFloat(totalAmount);
		currentTotal = parseFloat(currentTotal);

		if (currentTotal > totalAmount) {
			alert("Total amount cannot exceed the sum of selected rows' amounts.");
			return false;
		}


        var message = "";
        if ($('#Vendor').val() == "") {
            message += 'Vendor' + '<br>';
        }
		if ($('#PaymentAmount').val() == "" ||  parseFloat($('#PaymentAmount').val()) < 1) {
			message += 'Payment Amount' + '<br>';
        }
		if ($('#PaymentDate').val() == "") {
			message += 'Payment Date' + '<br>';
		}
		if ($('#OnlinePaymentRefNo').val() == "" && $('#ChequeNo').val() == "") {
			message += 'Online Payment Ref No / Cheque No - atleast one' + '<br>';
		}


        if (message != "") {

			$('#errorMessageForPayment').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
		$('#errorMessageForPayment').html("");
        return true;
	}

	function ValidatePendingTable() {
		var valid = false;

		// Loop through each row in the table
		$("#PendingBillTable tbody tr").each(function () {
			var col4Checkbox = $(this).find(".col4-checkbox");
			var col5Checkbox = $(this).find(".col5-checkbox");

			// Check if at least one checkbox in the 4th column is selected
			if (col4Checkbox.is(":checked")) {
				valid = true;
			}

			// Check if 5th column is selected without the 4th column
			if (col5Checkbox.is(":checked") && !col4Checkbox.is(":checked")) {
				valid = false;
			}
		});

		return valid;
	}

    function LoadBillData(billNo) {
		if ($("#Vendor").val() == '') {
			alert('Select Vendor');
			return false;
		}
		if (billNo == '') {
			alert('Enter Bill No');
			return false;
		}
		$("#SelectedChallanList").empty();
		$.ajax({
			url: '/BillPayment/GetBillData',
			type: 'GET',
			data: { billNo: billNo, vendor: $("#Vendor").val() },
			success: function (data) {
				if (data.Result.includes('Error')) {
					alert(data.Result);
					ClearScreen();
					return;
				}
				// Populate the form fields with data from the controller
				$('#BillNo').val(data.BillNo);
				$('#BillAmount').val(data.BillAmount);
				$('#BillDate').val(data.BillDate);
				$('#Company').val(data.Company);
				for (var i = 0; i < data.ChallanNoList.length; i++) {
					var currentChallanNo = data.ChallanNoList[i];
					AddToChallanList(currentChallanNo);
				}
				$('#PaymentDate').val('');
				$('#OnlinePaymentRefNo').val('');
				$('#ChequeNo').val('');
			},
			error: function () {
				alert('Error fetching data from the controller.');
			}
		});
	}
	function LoadPendingBillData() {
		if ($("#Vendor").val() == '') {
			alert('Select Vendor');
			return false;
		}
		$.ajax({
			url: '/BillPayment/GetPendingBillData',
			type: 'GET',
			data: { vendor: $("#Vendor").val() },
			success: function (data) {
				if (data.includes('Note')) {
					//alert(data);
					$("#errorMessageForPayment").text(data);
					$("#btnPaymentSave").prop("disabled", true);
					$("#ClearPaymentButton").prop("disabled", true);

					//ClearScreen();
					return;
				}
				else {
					$("#btnPaymentSave").prop("disabled", false);
					$("#ClearPaymentButton").prop("disabled", false);
					for (var i = 0; i < data.length; i++) {
						BillAddToTable(data[i].BillNo, data[i].BillDate, data[i].BillAmount, data[i].Company);
					}
				}
			},
			error: function () {
				alert('Error fetching data from the controller.');
			}
		});
	}
	function PaymentDetails() {

        $.ajax({
            url: '/BillPayment/GetPaymentDetails',
            type: 'GET',
            data: { vendor: $("#Vendor").val() },
            success: function (data) {
                // Populate the table with data from the controller
				var tbody = $('#PaymentListTable tbody');
                tbody.empty(); // Clear existing rows
                $.each(data, function (index, item) {
					var newRow = $('<tr>');
					newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.BillNo + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.PaymentAmount + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.PaymentDate + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.OnlinePaymentRefNo + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.ChequeNo + '</span>'));


                    tbody.append(newRow);
                });
            },
            error: function () {
                alert('Error fetching data from the controller.');
            }
        });
    }

    function PrintChallan() {
        if ($('#ChallanNumber').val() == 'undefined' || $('#ChallanNumber').val() == '') {
            alert('Please Enter a valid Challan Number');
            return;
        }
        var url = '@Url.Action("PrintChallan", "OutgoingChallan",new { challanNumber = "challan_number"})';
        url = url.replace("challan_number", $('#ChallanNumber').val());
        window.open(url,"_blank","top=20, left=20, scrollbars=yes width=800, height=500");
    }
	function ClearBillScreen() {
		$("#BillNo").val('');
		$("#BillDate").val('');
		$("#BillAmount").val('');
		selectedValues = [];
		$("#SelectedChallanList").empty();
		$("#errorMessageForList").text("");
	}
	function ClearPaymentScreen() {
		$("#PaymentAmount").val('');
		$("#PaymentDate").val('');
		$("#OnlinePaymentRefNo").val('');
		$("#ChequeNo").val('');

		$("#errorMessageForPayment").text("");
	}
    function ClearScreen() {

        /*$('#BalanceAmount').text("");*/
        // Clear textboxes and textareas
        $('input[type="text"], textarea').val('');
        $('input[type="number"]').val('');
        // Select the first option in dropdowns
        $('select').prop('selectedIndex', 0);

        // Uncheck checkboxes
        $('input[type="checkbox"]').prop('checked', false);

        // Unselect radio buttons
        $('input[type="radio"]').prop('checked', false);

        selectedValues = [];
		$("#errorMessageForList").text("");

    }

    function GetChallanNos() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetChallanNos","BillPayment")',
            data: { vendor: $("#Vendor").val() },
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#ChallanNo").html(s);
            }
        });
    }

	// Renders each selected Challan Number as a removable chip, matching the "Projects Loaded"
	// chip pattern used on the Purchase Order screen.
	function AddToChallanList(val) {

		if ($("#ChallanNo").val() === null || $("#ChallanNo").val() === '' || $("#ChallanNo").val() === 'undefined') {
			return;
		}

		var selectedValue = '';
		if (val == 'default') {
			selectedValue = $("#ChallanNo").val();
		}
		else {
			selectedValue = val;
		}

		if (selectedValues.indexOf(selectedValue) === -1) {
			// Create a new chip with the selected value
			var newChildDiv = $("<span>").addClass("ui-project-chip").text(selectedValue);

			// Add remove button
			var removeBtn = $("<span>").addClass("ui-project-chip-remove").html("&times;").attr("title", "Remove this Challan");
			removeBtn.on("click", function () {
				// Remove the corresponding chip when remove button is clicked
				newChildDiv.remove();
				// Remove the value from the array
				selectedValues = selectedValues.filter(function (value) {
					return value !== selectedValue;
				});
			});

			// Append the remove button to the chip
			newChildDiv.append(removeBtn);

			// Append the new chip to the list
			$("#SelectedChallanList").append(newChildDiv);

			// Add the selected value to the array
			selectedValues.push(selectedValue);

			// Clear error message
			$("#errorMessageForList").text("");
		} else {
			// Display error message if the value is a duplicate
			$("#errorMessageForList").text("Value already selected. Please choose a different value.");
		}
	}

	function BillAddToTable(BillNo, BillDate, Amount, Company) {

		//$("#PendingBillTable tbody tr").filter(":contains('" + BillNo + "')").remove();
		$("#PendingBillTable tbody tr:contains('" + BillNo + "') td:first-child").parent().remove();
		// Append product to the table
		$("#PendingBillTable tbody").append("<tr>" +
			"<td>" + BillNo + "</td>" +
			"<td>" + BillDate + "</td>" +
			"<td>" + Amount + "</td>" +
			"<td>" + Company + "</td>" +
			"<td><input type='checkbox' class='row-bill-selected' id='" + "PRChk_" + BillNo + "'/>" + "</td>" +
			"<td><input class='row-checkbox' type='checkbox' id='" + "PRFullPaymentChk_" + BillNo + "'/>" + "</td>" +
			"</tr>");
	}
</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-credit-card"></span>Vendor Bills and Payment
    </div>

    <form class="form-horizontal" role="form" name="BillForm" id="BillForm" autocomplete="off">
        <input type="hidden" name="ChallanNoList" id="ChallanNoList" />

        <!-- ================= Vendor ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-user"></span>Select Vendor</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Vendor" class="form-label required">Vendor Name</label>
                        <select class="form-control ui-input-md" id="Vendor" name="Vendor" required="required"></select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Bill Details ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-list-alt"></span>Bill Details</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="BillNo" class="form-label required">Bill Number</label>
                        <div class="input-group">
                            <input type="text" name="BillNo" id="BillNo" placeholder="Bill Number" class="form-control" />
                            <span class="input-group-btn">
                                <button class="btn btn-info" type="button" onclick="LoadBillData($('#BillNo').val());" title="Load this Bill">
                                    <span class="glyphicon glyphicon-search"></span>Load
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="BillDate" class="form-label required">Bill Date</label>
                        <input type="text" id="BillDate" name="BillDate" autocomplete="off" readonly="readonly" placeholder="Select Date" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="BillAmount" class="form-label required">Bill Amount</label>
                        <input type="number" id="BillAmount" name="BillAmount" placeholder="Bill Amount" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Company" class="form-label required">Company</label>
                        <select class="form-control" id="Company" name="Company" required="required">
                            <option value="">--Select--</option>
                            <option value="Fabritech">Oriental FabriTech</option>
                            <option value="Mechanical">Oriental Mechanical</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ChallanNo" class="form-label required">O/S Challan Number</label>
                        <div class="input-group">
                            <select class="form-control" id="ChallanNo" name="ChallanNo" required="required"></select>
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="AddToChallanList('default');" title="Add this Challan to the list">
                                    <span class="glyphicon glyphicon-plus"></span>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Challans for this Bill</label>
                        <div id="SelectedChallanList" class="ui-project-chip-list"></div>
                    </div>
                </div>
            </div>

            <div class="row ui-card-footer">
                <div class="col-md-12">
                    <div id="errorMessageForList" class="ui-error"></div>
                    <div id="errormessage" class="ui-error"></div>
                </div>
            </div>
        </div>

        <!-- ================= Save / Clear Bill - deliberately outside the card above: it acts on
              the whole Bill Section, not just the fields in Bill Details ================= -->
        <div class="row mt-3 mb-4" style="text-align:center;">
            <button type="button" id="btnBillSave" name="btnBillSave" class="btn btn-primary" onclick="BillSave();">
                <span class="glyphicon glyphicon-floppy-disk"></span>Save Bill
            </button>
            &nbsp;&nbsp;
            <button type="button" id="ClearBillButton" name="ClearBillButton" class="btn btn-default" onclick="ClearBillScreen();">
                <span class="glyphicon glyphicon-erase"></span>Clear Bill Details
            </button>
        </div>
    </form>

    <form class="form-horizontal" role="form" name="PaymentForm" id="PaymentForm" autocomplete="off">

        <!-- ================= Pending Bills ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-th-list"></span>Pending Bills</div>

            <div class="table-responsive">
                <table id="PendingBillTable" name="PendingBillTable" class="table table-bordered table-condensed table-striped ui-table">
                    <thead>
                        <tr>
                            <th>Bill No</th>
                            <th>Bill Date</th>
                            <th>Amount</th>
                            <th>Company</th>
                            <th>Select</th>
                            <th>Full Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= Payment Details ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-usd"></span>Payment Details</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="PaymentAmount" class="form-label required">Payment Amount</label>
                        <input type="text" id="PaymentAmount" name="PaymentAmount" placeholder="Payment Amount" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="PaymentDate" class="form-label required">Payment Date</label>
                        <input type="text" id="PaymentDate" name="PaymentDate" autocomplete="off" readonly="readonly" placeholder="Select Date" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="OnlinePaymentRefNo" class="form-label">Online Ref No</label>
                        <input type="text" id="OnlinePaymentRefNo" name="OnlinePaymentRefNo" placeholder="Online Ref Number" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ChequeNo" class="form-label">Cheque Number</label>
                        <input type="text" id="ChequeNo" name="ChequeNo" placeholder="Cheque Number" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row ui-card-footer">
                <div class="col-md-12">
                    <div id="message" name="message" class="ui-success"></div>
                    <div id="errorMessageForPayment" class="ui-error"></div>
                </div>
            </div>
        </div>

        <!-- ================= Save / Clear Payment / Export - deliberately outside the card above:
              Export Bills in particular isn't scoped to just the Payment Details fields ========== -->
        <div class="row mt-3 mb-4" style="text-align:center;">
            <button type="button" id="btnPaymentSave" name="btnPaymentSave" class="btn btn-primary" onclick="PaymentSaveNew();">
                <span class="glyphicon glyphicon-floppy-disk"></span>Save Payment
            </button>
            &nbsp;&nbsp;
            <button type="button" id="ClearPaymentButton" name="ClearPaymentButton" class="btn btn-default" onclick="ClearPaymentScreen();">
                <span class="glyphicon glyphicon-erase"></span>Clear Payment Details
            </button>
            &nbsp;&nbsp;
            <button type="button" id="btnExportBills" name="btnExportBills" class="btn btn-default" title="Export Vendor Bills to Excel">
                <span class="glyphicon glyphicon-save"></span>Export Bills
            </button>
        </div>

        <!-- ================= Payment History ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-list-alt"></span>Latest 20 Payment Transactions</div>

            <div class="table-responsive">
                <table id="PaymentListTable" name="PaymentListTable" class="table table-bordered table-condensed table-striped ui-table">
                    <thead>
                        <tr>
                            <th>Bill No(s)</th>
                            <th>Payment Amount (Rupees)</th>
                            <th>Payment Date</th>
                            <th>Online Reference No</th>
                            <th>Cheque No</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

