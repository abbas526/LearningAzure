<script>
    var Id = 0;
    var ProjectNames;
    var Balance = 0;
	var selectedValues = [];
    $(document).ready(function () {

        $("#Vendor").change(function () {

            $('#ChallanNo').empty();
			$('#PaymentListTable tbody').empty();
			$('#VendorTable tbody').empty();
			$('#PendingBillTable  tbody').empty();
			ClearBillScreen();
			ClearPaymentScreen();
            var selectedValue = $(this).val();

            $.ajax({
                url: '/BillPayment/GetChallanNumbers',
                type: 'GET',
                dataType: 'json',
                data: { vendor: selectedValue },
                success: function (data) {
                    var challanNo = $("#ChallanNo");
					challanNo.empty();
					if (data.includes('Note:')) {
						$('#errorMessageForList').html(data);
					}
					else {
						$.each(data, function (index, item) {
							challanNo.append('<option value="' + item + '">' + item + '</option>');
						});
					}
                },
                error: function (error) {
                    console.log(error);
                }
            });
			LoadPendingBillData();

			PaymentDetails();
        });


        $.ajax({
            type: "GET",
            url: '@Url.Action("GetVendorNames", "BillPayment")',
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#Vendor").html(s);
            }
        });
        $('#BillDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#PaymentDate').datepicker({
            dateFormat: "dd-mm-yy",
        });

         // If full payment is selected then display the total in the payment textbox
		$('#PendingBillTable').on('change', '.row-checkbox', function () {
			updateTotalAmount();
		});

		function updateTotalAmount() {
			// Get all checked checkboxes and sum their corresponding row amounts
			var totalAmount = 0;
			$('.row-checkbox:checked').each(function () {
				var row = $(this).closest('tr');
				var amount = parseFloat(row.find('td:eq(2)').text());
				if (!isNaN(amount)) {
					totalAmount += amount;
				}
			});

			// Display the total amount in the input field
			$('#PaymentAmount').val(totalAmount.toFixed(2));


		}

		$('#btnExportBills').click(function () {
            var url = '@Url.Action("WriteVendorBillsToExcel", "Report")';
            //var vendor = $('#VendorBills').val();
			window.location.href = url + '?Vendor=';
        });

    });



   function BillSave() {
            //Serialize the form data.
        if (ValidateBillForm() == false) { return false; }

       //$("#ChallanNoList").val(JSON.stringify(selectedValues));
	   $("#ChallanNoList").val(selectedValues.join(','));
        var valdata = $("#BillForm").serialize();
        // Save PO
        $.ajax({
            url: '@Url.Action("BillSave", "BillPayment")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                console.debug(data);
				if (data != 'Success') {
					alert(data);
                }
                else {
					alert('Saved Successfully');
					$('#errorMessageForList').html("<b>Saved Successfully</b>");
					setTimeout(function () { $("#errorMessageForList").hide(); }, 5000);

					BillAddToTable($('#BillNo').val(), $('#BillDate').val(), $('#BillAmount').val(), $('#Company').val());
					$("#btnPaymentSave").prop("disabled", false);
					$("#ClearPaymentButton").prop("disabled", false);
					$('#errorMessageForPayment').html("");
                }
            },
            failure: function (response) {
                alert("Error");
            }
        });

    }

	function PaymentSaveNew() {
		if (ValidatePaymentForm() == false) { return false; }
			// Collect data from plain text fields
		var formData = {
				Vendor: $('#Vendor').val(),
				PaymentAmount: $('#PaymentAmount').val(),
				PaymentDate: $('#PaymentDate').val(),
				OnlineRefNo: $('#OnlinePaymentRefNo').val(),
				ChequeNumber: $('#ChequeNo').val(),
			};

			// Collect data from the table
			formData.BillDetails = [];
		$('#PendingBillTable tbody tr').each(function () {
				var billNo = $(this).find('td:eq(0)').text();
				var amount = $(this).find('td:eq(2)').text();
				var paymentDone = $(this).find('td:eq(4) input[type="checkbox"]').prop('checked');
				var fullPaymentDone = $(this).find('td:eq(5) input[type="checkbox"]').prop('checked');
				if (paymentDone) {
					formData.BillDetails.push({
						BillNo: billNo,
						FullPaymentDone: fullPaymentDone,
						Amount: amount
					});
				}
			});
		if (formData.BillDetails === null || formData.BillDetails.length === 0)
			{
				$('#errorMessageForPayment').html("*Please select Bills against which payment is being made");
				return false;
			}
			// Send data to the controller using Ajax
			$.ajax({
				url: '/BillPayment/BillPaymentNewSave',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function (result) {
					console.debug(result);
					if (result != 'Success') {
						alert(result);
					}
					else {
						alert('Saved Successfully');
						$('#errorMessageForPayment').html("<b>Payment against Bill is saved successfully</b>");
						setTimeout(function () { $("#errorMessageForPayment").hide(); }, 5000);

						$("#PendingBillTable tbody tr").each(function () {
							// Check if the checkbox in the 5th column is checked
							if ($(this).find("td:eq(" + 4 + ") input[type='checkbox']").prop("checked")) {
								// If checked, clear the row
								$(this).empty();
							}
						});
						PaymentDetails();
						ClearPaymentScreen();
					}
				},
				error: function (error) {
					// Handle error
				}
			});
	}
    function ValidateBillForm() {

		var message = "";
		if ($('#Vendor').val() == "") {
			message += 'Vendor' + '<br>';
        }
		if (selectedValues.length == 0) {
			message += 'Challan Number' + '<br>';
		}
		if ($('#BillNo').val() == "") {
			message += 'Bill Number' + '<br>';
		}
		if ($('#BillDate').val() == "") {
			message += 'Bill Date' + '<br>';
		}
		if ($('#BillAmount').val() == "") {
			message += 'BillAmount' + '<br>';
		}
		if ($('#Company').val() == "") {
			message += 'Company' + '<br>';
		}
		if (message != "") {

			$('#errorMessageForList').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
			return false;
		}

		console.log($('#PaymentAmount').val());
		console.log(Balance);
		if (parseFloat($('#PaymentAmount').val()) > parseFloat(Balance)) {
			$('#errormessage').html("* <b> Payment Amount should not exceed Balance</b><br>");
			return false;
		}
		$('#errormessage').html("");
		return true;
	}
	function ValidatePaymentForm() {
		var totalAmount = 0;
		$('.row-bill-selected:checked').each(function () {
			var row = $(this).closest('tr');
			var amount = parseFloat(row.find('td:eq(2)').text());
			if (!isNaN(amount)) {
				totalAmount += amount;
			}
		});

		// Get the current value of the total amount input field
		var currentTotal = parseFloat($('#PaymentAmount').val());

		// Validate and update the total amount in the input field
		totalAmount = parseFloat(totalAmount);
		currentTotal = parseFloat(currentTotal);

		if (currentTotal > totalAmount) {
			alert("Total amount cannot exceed the sum of selected rows' amounts.");
			return false;
		}


        var message = "";
        if ($('#Vendor').val() == "") {
            message += 'Vendor' + '<br>';
        }
		if ($('#PaymentAmount').val() == "" ||  parseFloat($('#PaymentAmount').val()) < 1) {
			message += 'Payment Amount' + '<br>';
        }
		if ($('#PaymentDate').val() == "") {
			message += 'Payment Date' + '<br>';
		}
		if ($('#OnlinePaymentRefNo').val() == "" && $('#ChequeNo').val() == "") {
			message += 'Online Payment Ref No / Cheque No - atleast one' + '<br>';
		}


        if (message != "") {

			$('#errorMessageForPayment').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
		$('#errorMessageForPayment').html("");
        return true;
	}

	function ValidatePendingTable() {
		var valid = false;

		// Loop through each row in the table
		$("#PendingBillTable tbody tr").each(function () {
			var col4Checkbox = $(this).find(".col4-checkbox");
			var col5Checkbox = $(this).find(".col5-checkbox");

			// Check if at least one checkbox in the 4th column is selected
			if (col4Checkbox.is(":checked")) {
				valid = true;
			}

			// Check if 5th column is selected without the 4th column
			if (col5Checkbox.is(":checked") && !col4Checkbox.is(":checked")) {
				valid = false;
			}
		});

		return valid;
	}

    function LoadBillData(billNo) {
		if ($("#Vendor").val() == '') {
			alert('Select Vendor');
			return false;
		}
		if (billNo == '') {
			alert('Enter Bill No');
			return false;
		}
		$("#SelectedChallanList").empty();
		$.ajax({
			url: '/BillPayment/GetBillData',
			type: 'GET',
			data: { billNo: billNo, vendor: $("#Vendor").val() },
			success: function (data) {
				if (data.Result.includes('Error')) {
					alert(data.Result);
					ClearScreen();
					return;
				}
				// Populate the form fields with data from the controller
				$('#BillNo').val(data.BillNo);
				$('#BillAmount').val(data.BillAmount);
				$('#BillDate').val(data.BillDate);
				$('#Company').val(data.Company);
				for (var i = 0; i < data.ChallanNoList.length; i++) {
					var currentChallanNo = data.ChallanNoList[i];
					AddToChallanList(currentChallanNo);
				}
				$('#PaymentDate').val('');
				$('#OnlinePaymentRefNo').val('');
				$('#ChequeNo').val('');
			},
			error: function () {
				alert('Error fetching data from the controller.');
			}
		});
	}
	function LoadPendingBillData() {
		if ($("#Vendor").val() == '') {
			alert('Select Vendor');
			return false;
		}
		$.ajax({
			url: '/BillPayment/GetPendingBillData',
			type: 'GET',
			data: { vendor: $("#Vendor").val() },
			success: function (data) {
				if (data.includes('Note')) {
					//alert(data);
					$("#errorMessageForPayment").text(data);
					$("#btnPaymentSave").prop("disabled", true);
					$("#ClearPaymentButton").prop("disabled", true);

					//ClearScreen();
					return;
				}
				else {
					$("#btnPaymentSave").prop("disabled", false);
					$("#ClearPaymentButton").prop("disabled", false);
					for (var i = 0; i < data.length; i++) {
						BillAddToTable(data[i].BillNo, data[i].BillDate, data[i].BillAmount, data[i].Company);
					}
				}
			},
			error: function () {
				alert('Error fetching data from the controller.');
			}
		});
	}
	function PaymentDetails() {

        $.ajax({
            url: '/BillPayment/GetPaymentDetails',
            type: 'GET',
            data: { vendor: $("#Vendor").val() },
            success: function (data) {
                // Populate the table with data from the controller
				var tbody = $('#PaymentListTable tbody');
                tbody.empty(); // Clear existing rows
                $.each(data, function (index, item) {
					var newRow = $('<tr>');
					newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.BillNo + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.PaymentAmount + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.PaymentDate + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.OnlinePaymentRefNo + '</span>'));
                    newRow.append($('<td style="padding-left: 5px;">').html('<span>' + item.ChequeNo + '</span>'));


                    tbody.append(newRow);
                });
            },
            error: function () {
                alert('Error fetching data from the controller.');
            }
        });
    }

    function PrintChallan() {
        if ($('#ChallanNumber').val() == 'undefined' || $('#ChallanNumber').val() == '') {
            alert('Please Enter a valid Challan Number');
            return;
        }
        var url = '@Url.Action("PrintChallan", "OutgoingChallan",new { challanNumber = "challan_number"})';
        url = url.replace("challan_number", $('#ChallanNumber').val());
        window.open(url,"_blank","top=20, left=20, scrollbars=yes width=800, height=500");
    }
	function ClearBillScreen() {
		$("#BillNo").val('');
		$("#BillDate").val('');
		$("#BillAmount").val('');
		selectedValues = [];
		$("#SelectedChallanList").empty();
		$("#errorMessageForList").text("");
	}
	function ClearPaymentScreen() {
		$("#PaymentAmount").val('');
		$("#PaymentDate").val('');
		$("#OnlinePaymentRefNo").val('');
		$("#ChequeNo").val('');

		$("#errorMessageForPayment").text("");
	}
    function ClearScreen() {

        /*$('#BalanceAmount').text("");*/
        // Clear textboxes and textareas
        $('input[type="text"], textarea').val('');
        $('input[type="number"]').val('');
        // Select the first option in dropdowns
        $('select').prop('selectedIndex', 0);

        // Uncheck checkboxes
        $('input[type="checkbox"]').prop('checked', false);

        // Unselect radio buttons
        $('input[type="radio"]').prop('checked', false);

        selectedValues = [];
		$("#errorMessageForList").text("");

    }

    function GetChallanNos() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetChallanNos","BillPayment")',
            data: { vendor: $("#Vendor").val() },
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#ChallanNo").html(s);
            }
        });
    }

	function AddToChallanList(val) {

		if ($("#ChallanNo").val() === null || $("#ChallanNo").val() === '' || $("#ChallanNo").val() === 'undefined') {
			return;
		}

		var selectedValue = '';
		if (val == 'default') {
			selectedValue = $("#ChallanNo").val();
		}
		else {
			selectedValue = val;
		}

		if (selectedValues.indexOf(selectedValue) === -1) {
			// Create a new child div with the selected value
			var newChildDiv = $("<div>").addClass("selected-value").text(selectedValue + "  ");

			// Add remove button
			var removeBtn = $("<span>").addClass("glyphicon glyphicon-minus remove-btn");
			removeBtn.on("click", function () {
				// Remove the corresponding div when remove button is clicked
				newChildDiv.remove();
				// Remove the value from the array
				selectedValues = selectedValues.filter(function (value) {
					return value !== selectedValue;
				});
			});

			// Append the remove button to the div
			newChildDiv.append(removeBtn);

			// Append the new child div to the result div
			$("#SelectedChallanList").append(newChildDiv);

			// Add the selected value to the array
			selectedValues.push(selectedValue);

			// Clear error message
			$("#errorMessageForList").text("");
		} else {
			// Display error message if the value is a duplicate
			$("#errorMessageForList").text("Value already selected. Please choose a different value.");
		}


		//// Create a new child div with the selected value
		//var newChildDiv = $("<div>").addClass("selected-value").text(selectedValue);

		//// Append the new child div to the result div
		//$("#SelectedChallanList").append(newChildDiv);
	}

	function BillAddToTable(BillNo, BillDate, Amount, Company) {

		//$("#PendingBillTable tbody tr").filter(":contains('" + BillNo + "')").remove();
		$("#PendingBillTable tbody tr:contains('" + BillNo + "') td:first-child").parent().remove();
		// Append product to the table
		$("#PendingBillTable tbody").append("<tr>" +
			"<td>" + BillNo + "</td>" +
			"<td>" + BillDate + "</td>" +
			"<td>" + Amount + "</td>" +
			"<td>" + Company + "</td>" +
			"<td><input type='checkbox' class='row-bill-selected' id='" + "PRChk_" + BillNo + "'/>" + "</td>" +
			"<td><input class='row-checkbox' type='checkbox' id='" + "PRFullPaymentChk_" + BillNo + "'/>" + "</td>" +
			"</tr>");
	}
</script>
<div class="container">
