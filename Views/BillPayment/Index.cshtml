					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>

		</div>


		<div class="row">
			<div class="form-group col-md-6">
				<label for="email" class="col-sm-3 control-label">Payment Amount</label>
				<div class="col-sm-6">
					<input type="text" id="PaymentAmount" name="PaymentAmount" placeholder="Payment Amount" class="form-control">
				</div>
			</div>
			<div class="form-group col-md-6">
				<label for="Specs" class="col-sm-3 control-label ">Payment Date</label>
