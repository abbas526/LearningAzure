            "<td><select class='form-control' style='width: 7em' id='" + "ItemReceivedOK_" + Id + "'>" + "<option value='Ok' selected>Ok</option><option value='Not Ok' >Not Ok</option></select></td>" +
            "<td><textarea class='form-control' rows=2 cols=20 id='" + "ItemReceivedComment_" + Id + "'/>" + "</textarea>" +
            "<td>" + (Id === 1 ? "<select class='vendorclass form-control' style='width: 18em' id='" + "Vendor_" + Id + "'></select>" : "") + "</td>" +
