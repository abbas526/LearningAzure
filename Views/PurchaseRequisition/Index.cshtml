    function FillItemsArray() {
        var items = new Array();
        var ct = 1;
        $("#ItemReceivedTable tbody tr").each(function () {
            var row = $(this);
            var item = {};
            item.ItemReceivedChallanNo = row.find('#ItemReceivedChallanNo_' + ct).val();
            item.ItemReceivedDate = row.find("#ItemReceivedDate_" + ct).val();
            item.ItemReceivedOK = row.find("#ItemReceivedOK_" + ct).val();
            item.ItemReceivedComment = row.find("#ItemReceivedComment_" + ct).val();
            item.Vendor = $("#Vendor_" + 1).val();
            item.PRNumber = $('#PRNo').val();
            items.push(item);
            ct = ct + 1;
        });

        // Check for duplicates
        if (hasDuplicateChallanNo(items)) {
            alert("Error: Duplicate values found in Challan No.");
            return false;
        }

        return items;
    }


    function hasDuplicateChallanNo(items) {
        var seenChallanNos = {};

        for (var i = 0; i < items.length; i++) {
            var challanNo = items[i].ItemReceivedChallanNo;

            if (seenChallanNos[challanNo]) {
                return true; // Duplicate found
            }

            seenChallanNos[challanNo] = true;
        }

        return false; // No duplicates found
    }

    function SaveItemReceivedData() {



        $('#ItemReceivedErrorMessage').html("");

        if ($('#PRNo').val() == 'undefined' || $('#PRNo').val() == '') {
            $('#ItemReceivedErrorMessage').html("* <b>Please select PR No for Item Received</b>");
            return false;
        }

