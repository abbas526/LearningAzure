        var isAllItemReceived = $('input[name="IsAllItemReceived"]:checked').val();

       if (itemReceivedList.length > 0) {
           console.log(itemReceivedList);
           itemReceivedList = JSON.stringify({ 'itemReceivedList': itemReceivedList, IsAllItemReceived: isAllItemReceived });

