@{
	ViewBag.Title = "Index";
}

<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>
<script src="~/Scripts/form-validation.js"></script>
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css" rel="stylesheet" />

<script type="text/javascript">
    var VendorList; var Id = 0;
    // Item names for the Quick-add grid's per-row Item dropdown - captured from the same
    // GetItemNames call that fills #ItemDropdown (single-PR edit mode) below.
    var ItemNamesList = [];
    var qaRowSeq = 0;

    // Requisition Details has two mutually-exclusive modes:
    //  - Quick-add (#QuickAddPRSection): the default, for entering several new PRs in a row.
    //  - Edit (#SinglePREditSection): shown once an existing PR is loaded via the Load button.
    function switchToQuickAddMode() {
        $('#SinglePREditSection').hide();
        $('#QuickAddPRSection').show();
    }
    function switchToEditMode() {
        $('#QuickAddPRSection').hide();
        $('#SinglePREditSection').show();
    }

    function PrintPR() {
        if ($('#PRNo').val() == 'undefined' || $('#PRNo').val() == '') {
            alert('Please Enter a valid PR Number');
            return;
        }
        var url = '@Url.Action("PrintPR", "PurchaseRequisition",new { PRNumber = "pr_number"})';
        url = url.replace("pr_number", $('#PRNo').val());
        window.open(url,"_blank","top=20, left=20, scrollbars=yes width=800, height=500");
    }

    // Load button is always visible; format is checked when it's clicked (see LoadPRClicked below),
    // e.g. "KSK-123" (user code abbreviation, a dash, then digits) - matches the UserCode dropdown
    // values above (KSK, JB, AS, MA, CV, IS, OFMS, OMMS).
    var PRNoFormat = /^[A-Za-z]+-\d+$/;
    // Called everywhere #PRNo's value changes (load, save, new/reset, clear) - keeps the Load
    // button and the "PR No: ..." label next to the Quick PO title both in sync with it.
    function updateLoadButtonVisibility() {
        $('#btnSearchPR').show();
        var prNo = $('#PRNo').val();
        $('#QuickPOPRNoDisplay').text(prNo ? 'PR No : ' + prNo : '');
    }

	function PRAddToTable(PRNumber, Item, Qty, Size, Unit, MOC, PRDate, DateRequired, Remark, IsAllItemReceived, AssignedToPO) {
		// Normalize "All Item Recd" to just yes/no - the DB (and PRGet) can hand back null/blank
		// for a PR that's never had the Item Received flag set, which used to render literally as
		// the string "null"/"undefined" in this column instead of a sensible default.
		var isAllItemReceived = (IsAllItemReceived != null && IsAllItemReceived.indexOf('yes') >= 0) ? 'yes' : 'no';

		// Append product to the table
		var newRow = $("<tr>" +
			"<td><a href='#' onclick=LoadPR('" + PRNumber + "')>" + PRNumber + "</a></td>" +
			"<td>" + Item + "</td>" +
			"<td style='width:15%;'>" + Size + "</td>" +
			"<td>" + MOC + "</td>" +
			"<td>" + Qty + "</td>" +
			"<td>" + Unit + "</td>" +
			"<td>" + PRDate + "</td>" +
			"<td>" + DateRequired + "</td>" +
			"<td>" + Remark + "</td>" +
			"<td>" + isAllItemReceived + "</td>" +
			"</tr>");

		// Tag the row with its colour category (also drives the Colour Filter dropdown above the
		// table - keep this in sync with that dropdown's option values).
		var rowColour = 'white';
		if (isAllItemReceived === 'yes') {
			rowColour = 'green';
			newRow.css('background-color', '#c8f7c8');
		}
        else if (AssignedToPO != '' && AssignedToPO !== undefined && AssignedToPO != 'Not Mapped') {
			rowColour = 'yellow';
			newRow.css('background-color', 'yellow');
        }
		newRow.attr('data-rowcolour', rowColour);
		// Tag the row with its PR No too, so a deleted PR's row can be picked out of this table
		// directly (see RemovePR) instead of reloading the whole listing.
		newRow.attr('data-prno', PRNumber);


		// Append the new row to the table
		$("#PRTable tbody").append(newRow);
	}

	// Removes a PR's row from #PRTable by PR No, if it's currently listed there - used by
	// RemovePR (Admin Action) so a deleted PR doesn't stay visible in the listing below.
	// Case/whitespace-insensitive since it's matching a typed Admin Action value against
	// whatever GetPRs/PRSave originally rendered into the row.
	function removePRRowFromTable(prNo) {
		var target = $.trim(prNo).toUpperCase();
		$("#PRTable tbody tr").filter(function () {
			return $.trim($(this).attr('data-prno') || '').toUpperCase() === target;
		}).remove();
	}

	// Rebuilds the Item/MOC filter dropdowns above #PRTable from whatever rows are actually in
	// the table right now, so they only ever offer values found in the project currently listed
	// there - never the full app-wide item/MOC list. Called after GetPRs() populates the table,
	// and again whenever a row is added directly (SaveData, QuickAddSaveRow) without going
	// through GetPRs, so a freshly-saved PR's Item/MOC shows up immediately too.
	// Preserves the current selection if it's still one of the available values.
	function refreshPRTableFilterDropdowns() {
		var uniqueItems = [];
		var uniqueMOC = [];

		$("#PRTable tbody tr").each(function () {
			var row = $(this);
			var itemVal = row.find("td:eq(1)").text().trim();
			var mocVal = row.find("td:eq(3)").text().trim();

			if (itemVal !== '' && $.inArray(itemVal, uniqueItems) === -1) {
				uniqueItems.push(itemVal);
			}
			if (mocVal !== '' && $.inArray(mocVal, uniqueMOC) === -1) {
				uniqueMOC.push(mocVal);
			}
		});
		uniqueItems.sort();
		uniqueMOC.sort();

		var previousItem = $("#ItemDropdownPRTable").val();
		var previousMOC = $("#MOCDropdownPRTable").val();

		$("#ItemDropdownPRTable").empty().append('<option value="">-- Select Item --</option>');
		$.each(uniqueItems, function (i, item) {
			$("#ItemDropdownPRTable").append('<option value="' + item + '">' + item + '</option>');
		});
		$("#ItemDropdownPRTable").prop("disabled", uniqueItems.length === 0);
		if ($.inArray(previousItem, uniqueItems) !== -1) {
			$("#ItemDropdownPRTable").val(previousItem);
		}

		$("#MOCDropdownPRTable").empty().append('<option value="">-- Select MOC --</option>');
		$.each(uniqueMOC, function (i, item) {
			$("#MOCDropdownPRTable").append('<option value="' + item + '">' + item + '</option>');
		});
		$("#MOCDropdownPRTable").prop("disabled", uniqueMOC.length === 0);
		if ($.inArray(previousMOC, uniqueMOC) !== -1) {
			$("#MOCDropdownPRTable").val(previousMOC);
		}

		// Re-apply the Colour Filter (Item/MOC dropdowns above were just rebuilt, but Colour
		// Filter isn't - honour it if one was already selected).
		applyPRTableFilters();
	}

	// Combines the Item, MOC and Colour filters above #PRTable into a single pass, so all three
	// narrow the table together instead of each one undoing what the others hid.
	function applyPRTableFilters() {
		var selectedItem = $("#ItemDropdownPRTable").val();
		var selectedMOC = $("#MOCDropdownPRTable").val();
		var selectedColour = $("#ColourFilterPRTable").val();

		$("#PRTable tbody tr").each(function () {
			var row = $(this);
			var rowItem = row.find("td:eq(1)").text().trim();
			var rowMOC = row.find("td:eq(3)").text().trim();
			var rowColour = row.attr('data-rowcolour') || 'white';

			var matches = (selectedItem === "" || rowItem === selectedItem) &&
				(selectedMOC === "" || rowMOC === selectedMOC) &&
				(selectedColour === "" || rowColour === selectedColour);

			row.toggle(matches);
		});
	}

	// Sorts #PRTable's rows in place by its PR Date (colIndex 6) or Reqd Date (colIndex 7) column.
	// Re-appending every row - filtered-out ones included - keeps this correct regardless of
	// whether a filter is active: a hidden row just stays hidden (applyPRTableFilters controls
	// that separately via display:none) wherever the sort places it, so the visible rows - full
	// list or filtered subset, whichever is showing - end up in the requested order.
	function sortPRTableByDate(colIndex, direction) {
		var tbody = $('#PRTable tbody');
		var rows = tbody.find('tr').get();

		rows.sort(function (rowA, rowB) {
			var dateA = parsePRTableDate($(rowA).find('td').eq(colIndex).text().trim());
			var dateB = parsePRTableDate($(rowB).find('td').eq(colIndex).text().trim());

			// Rows with a blank/unparsable date sort after every dated row, either direction.
			if (dateA === null && dateB === null) return 0;
			if (dateA === null) return 1;
			if (dateB === null) return -1;

			return direction === 'asc' ? dateA - dateB : dateB - dateA;
		});

		$.each(rows, function (i, row) {
			tbody.append(row);
		});
	}

	// #PRTable's PR Date/Reqd Date columns are always rendered dd-MM-yyyy - every source of this
	// table's data goes through PurchaseRequisitionRepository.SafeFormatDate, which normalizes to
	// that format. Returns a comparable timestamp, or null if the cell is blank/unparsable.
	function parsePRTableDate(text) {
		if (!text) return null;
		var parts = text.split('-');
		if (parts.length !== 3) return null;
		var day = parseInt(parts[0], 10);
		var month = parseInt(parts[1], 10);
		var year = parseInt(parts[2], 10);
		if (isNaN(day) || isNaN(month) || isNaN(year)) return null;
		return new Date(year, month - 1, day).getTime();
	}

    $(document).ready(function () {

        $("#ItemDropdownPRTable").change(function () {
            applyPRTableFilters();
        });

        $("#MOCDropdownPRTable").change(function () {
            applyPRTableFilters();
        });

        $("#ColourFilterPRTable").change(function () {
            applyPRTableFilters();
        });

        $.ajax({
                    type: "GET",
                    url: '@Url.Action("GetVendorNames","PurchaseOrder")',
                    success: function (data) {
                       VendorList = data;
                       var s = '<option value="">Please Select</option>';
                       for (var i = 0; i < data.length; i++) {
                           s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                       }
                        $("#Vendor").html(s);
                    }
        });

        $.ajax({
                   type: "GET",
                   url: '@Url.Action("GetVendorNames","PurchaseOrder")',
                   success: function (data) {
                       var s = '<option value="">Please Select</option>';
                       for (var i = 0; i < data.length; i++) {
                           s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                       }
                       $("#VendorForPO").html(s);
                   }
        });


        $("#PRNo").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetSearchValue","PurchaseRequisition")',
                    dataType: "json",
                    data: { search: $("#PRNo").val() },
                    success: function (data) {

                        response($.map(data, function (item) {
                            return { label: item, value: item };
                        }));
                    },
                    error: function (xhr, status, error) {
                        alert("Error");
                    }
                });
            }
        });

          $.ajax({
               type: "GET",
               url: '@Url.Action("GetProjectNames","PurchaseRequisition")',
               success: function (data) {
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   // Same project list feeds the Requisition Details dropdown and the standalone
                   // one next to "Purchase Requisitions for Project" below.
                   $("#ProjectRefDropdown, #ProjectRefDropdownList").html(s);
               }
          });

          $.ajax({
               type: "GET",
               url: '@Url.Action("GetOldProjectNames","PurchaseRequisition")',
               success: function (data) {
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   $("#OldProjects").html(s);
               }
          });


         $.ajax({
               type: "GET",
               url: '@Url.Action("GetItemNames","PurchaseRequisition")',
               success: function (data) {
                   ItemNamesList = data;
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   $("#ItemDropdown").html(s);
                   QuickAddRefreshItemOptions();
             }
         });

        var rowCount = $("#ItemReceivedTable tbody tr").length;
        if (rowCount == 0) {
            $('input[name="IsAllItemReceived"][value="yes"]').prop('checked', false);
            $('input[name="IsAllItemReceived"][value="no"]').prop('checked', false);
        }


        $('#QuickPOSection').hide();
        $('#ItemReceivedSection').hide();
        $('#btnSave').prop('disabled', true);
        $('#PRDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#DateRequired').datepicker({
            dateFormat: "dd-mm-yy",
        });

        // PR No starts blank, and the Admin Code must always be re-typed - never left
        // pre-filled by the browser's saved-password autofill.
        $('#PRNo').val('');
        $('#POAdminCode').val('');
        $('#PRNo').on('input', updateLoadButtonVisibility);
        updateLoadButtonVisibility();

        // Default screen state: ready to quick-add new PR(s), not editing an existing one.
        switchToQuickAddMode();
        QuickAddEnsureAtLeastOneRow();
    });

</script>

<script>


    function ShowSaveSuccess(res) {
        $("#message").text(res);
        alert(res);
        setTimeout(function() { $("#message").hide(); }, 5000);
    }
    // Wipes every field/table/message on the screen back to the same blank state a fresh page
    // load starts in - PR details, the Item Received table, the PR listing grid, the Quick PO
    // section, and all message/error boxes. Shared by "New PR" and "Reset" below; they only differ
    // in what state PRNo/Save are left in afterwards.
    function ClearAllFieldsAndTables() {
        // PR detail fields
        $("#UserCode").val('');
        $("#PRDate").val('');
        $("#ItemDropdown").val('');
        $("#NewItem").val('');
        $("#ProjectRefDropdown").val('');
        $("#ItemSize").val('');
        $("#Specs").val('');
        $("#Quantity").val('');
        $("#DateRequired").val('');
        $("#Unit").val('');
        $("#OldProjects").val('');
        $("#Remark").val('');
        $("#Drawing").val('');
        $("#PONumber").text('');

        // PR No + Load button
        $("#PRNo").val('');
        $('#PRNo').prop('disabled', false);
        updateLoadButtonVisibility();

        // Messages
        $('#message').empty();
        $('#errormessage').empty();
        $('#messagePO').empty();
        $('#ItemReceivedErrorMessage').empty();

        // Item Received section
        $('#ItemReceivedTable tbody').empty();
        $('input[name="IsAllItemReceived"][value="yes"]').prop('checked', false).prop('disabled', false);
        $('input[name="IsAllItemReceived"][value="no"]').prop('checked', false).prop('disabled', false);
        $('#btnAddItem').prop('disabled', false);

        // PR listing grid + its filter dropdowns (same reset shape GetPRs() uses before loading)
        $('#PRTable tbody').empty();
        $("#ItemDropdownPRTable").empty().append('<option value="">-- Select Item --</option>').prop("disabled", true);
        $("#MOCDropdownPRTable").empty().append('<option value="">-- Select MOC --</option>').prop("disabled", true);
        $('#ColourFilterPRTable').val('');
        $('#ProjectRefDropdownList').val('');

        // Quick PO section
        $('#Rate').val('');
        $('#POQty').val('');
        $('#VendorForPO').val('');
        $('#PORemarks').val('');
        $('#PRNumberHidden').val('');
        $('#QuickPOSection').hide();

        $('#btnSave').prop('disabled', true);

        // Quick-add grid
        QuickAddResetGrid();
    }

    function AddData() {
        // Exception to the full reset: User Code is who you're working as, not part of any one
        // PR's data - keep it selected across "New PR" so it doesn't have to be re-picked.
        var userCode = $('#UserCode').val();
        ClearAllFieldsAndTables();
        $('#UserCode').val(userCode);
        // Ready to enter a brand new PR: number is auto-assigned on save, so lock the field
        // and enable Save.
        $('#PRNo').prop('disabled', true);
        $('#btnSave').prop('disabled', false);
        switchToQuickAddMode();
    }

    // "Cancel"/Reset: undo whatever was on screen (including a pending "New PR") and bring the
    // page back to exactly the state it was in when it first loaded - no actual page reload.
    function CancelToFreshScreen() {
        ClearAllFieldsAndTables();
        switchToQuickAddMode();
    }
    function SaveData() {
        debugger;
        if (ValidateForm() == false) {
            return false;
        }
        $('#errormessage').empty();
            //Serialize the form datas.
            var valdata = $("#PRForm").serialize();
            //to get alert popup
        $.ajax({
            url: '@Url.Action("PRSave","PurchaseRequisition")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data.Result == 'Error' || data.Result == 'Record Not Found' || data.Result.includes('Error') == true) {
                    alert(data.Result);
                    }
                else if (data != null && data.PRNumber !== 'undefined' && data.PRNumber != '') {
                    if (data.IsNew == 'true') {
                        PRAddToTable(data.PRNo, data.ItemDropdown, data.Quantity, data.ItemSize, data.Unit, data.Specs, data.PRDate, data.DateRequired, data.Remark, data.IsAllItemReceived,'');
                        refreshPRTableFilterDropdowns();
                    }
                     $('#PRNo').val(data.PRNo);
                     updateLoadButtonVisibility();
                     ShowSaveSuccess(data.Result);
                    }
                    else {
                        alert(data);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
        //ShowSaveSuccess();
        $('#btnSave').prop('disabled', true);
        $('#PRNo').prop('disabled', false);
    }
    function LoadPR(PRNumber) {
        $("#PRNo").val(PRNumber);
        updateLoadButtonVisibility();
        LoadData();
    }

    // Load button click handler: the button is always shown, so the PR number format is
    // validated here instead of via visibility. PRGet itself still guards against a PR number
    // that's correctly formatted but doesn't exist (see the data.PRNo check in LoadData below).
    function LoadPRClicked() {
        if (!PRNoFormat.test($('#PRNo').val().trim())) {
            alert('Enter a valid PR number');
            return;
        }
        $('#PRNo').prop('disabled', false);
        LoadData();
    }

    function LoadData() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("PRGet","PurchaseRequisition")',
            dataType: 'json',
            data: { PRNo: $('#PRNo').val() },
            success: function (data) {
                //debugger;
                console.log(data);
                // PRGet returns a near-empty PurchaseRequisition (no PRNo) with Result set to an
                // error message when the PR wasn't found - don't populate the form from that.
                if (!data || !data.PRNo) {
                    alert(data && data.Result ? data.Result : 'Enter a valid PR number');
                    return;
                }
                switchToEditMode();
                $("#PRDate").val(data.PRDate);
                $("#PRNo").val(data.PRNo);
                updateLoadButtonVisibility();
                // #ProjectRefDropdown is only ever populated with ACTIVE projects
                // (GetProjectNames() filters IsActive='yes'). A PR saved against a project that
                // has since been made inactive won't have a matching <option>, so .val() below
                // would silently fail to select anything. Add a stand-in option for it first.
                if (data.ProjectRefDropdown &&
                    $("#ProjectRefDropdown option").filter(function () { return $(this).val() === data.ProjectRefDropdown; }).length === 0) {
                    $("#ProjectRefDropdown").append($("<option>", { value: data.ProjectRefDropdown, text: data.ProjectRefDropdown + " (Inactive)" }));
                }
                $("#ProjectRefDropdown").val(data.ProjectRefDropdown);
                $("#ItemDropdown").val(data.ItemDropdown);
                $("#ItemSize").val(data.ItemSize);
                $("#Specs").val(data.Specs);
                $("#Quantity").val(data.Quantity);
                $("#DateRequired").val(data.DateRequired);
                $("#Remark").val(data.Remark);
				$("#Drawing").val(data.Drawing);
                $("#Unit").val(data.Unit);
                $("#UserCode").val(data.UserCode);
				$("#PONumber").text(data.AssociatedPONumbers);
                //$("#ItemReceivedDate").val(data.ItemReceivedObj.ItemReceivedDate);
                //$("#ItemReceivedOK").val(data.ItemReceivedObj.ItemReceivedOK);
                //$("#ItemReceivedComment").val(data.ItemReceivedObj.ItemReceivedComment);
                //$('#Vendor').val(data.ItemReceivedObj.Vendor);
                //$('#ItemReceivedChallanNo').val(data.ItemReceivedObj.ItemReceivedChallanNo);
                $("#NewItem").val('');
                if (data.IsAllItemReceived === 'yes') {
                    $('input[name="IsAllItemReceived"][value="yes"]').prop('checked', true);
                    $('input[name="IsAllItemReceived"][value="no"]').prop('disabled', true);
                    $('#btnAddItem').prop('disabled', true);
                }
                if (data.IsAllItemReceived === 'no') {
                    $('input[name="IsAllItemReceived"][value="no"]').prop('checked', true);
                }
                if (isEmpty(data.IsAllItemReceived)) {
                    $('input[name="IsAllItemReceived"][value="yes"]').prop('checked', false);
                    $('input[name="IsAllItemReceived"][value="no"]').prop('checked', false);
                    $('input[name="IsAllItemReceived"][value="no"]').prop('enabled', true);
                    $('input[name="IsAllItemReceived"][value="yes"]').prop('enabled', true);
                }
                // Populate the table with data from the controller
                var tbody = $('#ItemReceivedTable tbody');
                tbody.empty(); // Clear existing rows
                var ctr = 1;
                if (data.ItemReceivedList != null && data.ItemReceivedList.length > 0) {
                    $.each(data.ItemReceivedList, function (index, item) {
                        var newRow = $('<tr>');

                        newRow.append($('<td>').html('<input type="text" class="form-control" style="width: 12em"  Id="ItemReceivedChallanNo_' + ctr + '" value="' + item.ItemReceivedChallanNo + '"/>'));
                        newRow.append($('<td>').html('<input type="text" size="8" class="RecDate form-control" style="width: 7em" Id="ItemReceivedDate_' + ctr + '" value="' + item.ItemReceivedDate + '"/>'));
                        newRow.append($('<td>').html('<input type="text" size="8" class="form-control" style="width: 7em" Id="ItemReceivedOK_' + ctr + '" value="' + item.ItemReceivedOK + '"/>'));
                        //newRow.append($('<td>').html('<textarea rows=2 cols=20 Id="Comment_' + ctr + '" value="' + item.ItemReceivedComment + '"/></textarea>'));
                        newRow.append($('<td>').html('<textarea class="form-control" Id="ItemReceivedComment_' + ctr + '" rows="2">' + item.ItemReceivedComment + '</textarea>'));
                        if (ctr === 1) {
                            newRow.append($('<td>').html('<select class="form-control" style="width: 18em" Id="Vendor_' + ctr + '" />'));
                        }
                        else {
                            newRow.append($('<td>').html(''));
                        }
                        newRow.append($('<td>').html('<button type="button" class="btn btn-danger btn-xs" onclick="DeleteItem(' + ctr + ')" Id=delete_' + ctr + '>Delete</button>'));
                        tbody.append(newRow);

                        var vendorDropdown = newRow.find("select");

                        for (var i = 0; i < VendorList.length; i++) {
                            var vendorName = VendorList[i];

                            if (vendorName === item.Vendor) {
                                vendorDropdown.append($("<option>", {
                                    value: vendorName,  // Set the value equal to the text
                                    text: vendorName,    // Set the text to the same value
                                    selected: true
                                }));
                            }
                            else {
                                vendorDropdown.append($("<option>", {
                                    value: vendorName,  // Set the value equal to the text
                                    text: vendorName    // Set the text to the same value
                                }));
                            }
                        }

                        ctr = ctr + 1;
                        $('#delete_1').hide();
                        $('.RecDate').datepicker({
                            dateFormat: "dd-mm-yy",
                        });
                    });
                }
                else {
                    // If any specific PR is not having any Item Received data
                    ItemReceivedAddToTable();
                }

            },
            error: function (ex) {
                alert('PR Not Found');
                console.log(ex);
            }
        });
        $('#btnSave').prop('disabled', false);

        return false;
    }
    function isEmpty(value) {
        return (value == null || (typeof value === "string" && value.trim().length === 0));
    }
    function ValidateForm() {

        var message = "";

        if ($('#UserCode').val() == "")
            message += 'User Code<br>';

        if ($('#PRDate').val() == "")
            message += 'Purchase Requisition Date<br>';

        if ($('#ItemDropdown').val() == "" && $('#NewItem').val() == "")
            message += 'Item<br>';

        if ($('#ProjectRefDropdown').val() == "")
            message += 'Project Ref<br>';

        if ($('#ItemSize').val() == "")
            message += 'Size<br>';

        if ($('#Specs').val() == "")
            message += 'Spec/MOC<br>';

        if ($('#Quantity').val() == "")
            message += 'Quantity<br>';
        else if (!$.isNumeric($('#Quantity').val()))
            message += 'Quantity is not numeric<br>';

        if ($('#DateRequired').val() == "")
            message += 'Date Required<br>';

        if ($('#Unit').val() == "")
            message += 'Unit of Measurement<br>';

        if (message !== "") {
            $('#errormessage').html("* <b>Please fill below values</b><br><br>" + message);
            return false;
        }

        $('#errormessage').empty();
        return true;
    }

    function GetPRs(projectType) {

        $("#ItemDropdownPRTable")
            .empty()                                      // remove old options
            .append('<option value="">-- Select Item --</option>') // default option
            .prop("disabled", true);                      // disable until items load

        $("#MOCDropdownPRTable")
            .empty()                                      // remove old options
            .append('<option value="">-- Select MOC --</option>') // default option
            .prop("disabled", true);                      // disable until items load


        var projectname = '';

        if (projectType == 'old') {
            projectname = $("#OldProjects").val();
        }
        else if (projectType == 'list') {
            // Dropdown next to the "Purchase Requisitions for Project" table itself, so browsing
            // a project's PRs doesn't require touching the Requisition Details card above.
            projectname = $("#ProjectRefDropdownList").val();
        }
        else {
            projectname = $("#ProjectRefDropdown").val();
        }
         $.ajax({
             type: "GET",
             url: '@Url.Action("GetPRs","PurchaseRequisition")',
             data: { project: projectname },
             success: function (data) {
                 $("#PRTable tbody").html('');
                 if (data == null || data.length == 0) {
                     alert("No PR Records");
                 }
                 else {
                     for (var i = 0; i < data.length; i++) {
                         PRAddToTable(data[i].PRNo, data[i].ItemDropdown, data[i].Quantity, data[i].ItemSize, data[i].Unit, data[i].Specs, data[i].PRDate, data[i].DateRequired, data[i].Remark, data[i].IsAllItemReceived, data[i].AssignedToPO);
                     }
                     // Item/MOC dropdowns only ever offer values actually present in this
                     // project's PRs - never the full app-wide item/MOC list.
                     refreshPRTableFilterDropdowns();
                 }
             }
         });
    }

    function ExportPRsForProject(source) {
        var url = '@Url.Action("WritePRsForProjectItemToExcel", "Report")';
        var projectname = (source == 'list') ? $("#ProjectRefDropdownList").val() : $("#ProjectRefDropdown").val();

        // Replace '&' with '||' in the project name
        var modifiedProjectName = projectname.replace(/&/g, '||');

        window.location.href = url + '?ProjectName=' + encodeURIComponent(modifiedProjectName);
    }

    function RemovePR() {
        var code = $('#POAdminCode').val();
        if (code == '') {
            alert("Please enter Admin Code"); return false;
        }
        // Deliberately its own field, separate from the "Purchase Requisition No" textbox up top -
        // Delete PR always acts on #DeletePRNo, never on whatever happens to be loaded above.
        var prNumber = $('#DeletePRNo').val();

        if (prNumber == '') {
            alert("Please enter PR No to Delete"); return false;
        }

        var res = confirm("Are you sure to delete the PR.");
        if (res == false) {
            return 0;
        }

         $.ajax({
             type: "GET",
             url: '@Url.Action("RemovePR","PurchaseRequisition")',
             data: { prNumber: prNumber, poAdminCode: code },
             success: function (data) {
                 if (data.includes('Error') == true) {
                     alert(data);
                 }
                 else {
                     alert('PR Record Successfully Deleted');
                     ClearScreen();
                     // If the deleted PR is currently shown in the "Purchase Requisitions for
                     // Project" table below, remove its row too instead of leaving it listed.
                     removePRRowFromTable(prNumber);
                     refreshPRTableFilterDropdowns();
                 }
             }
         });

    }

