    function DeleteItem(id) {
        // Ask for confirmation before deleting
        var confirmation = window.confirm("Are you sure you want to delete this challan?");

        if (confirmation) {
            // Remove the row with the corresponding ID
            $("#ItemReceivedChallanNo_" + id).closest("tr").remove();
        }
    }

    function ValidateItemReceivedRows() {
        // Get all the rows in the table's tbody
        var rows = $("#ItemReceivedTable tbody tr");

        // Initialize a flag to track if all rows are valid
        var allRowsValid = true;

        // Loop through each row and validate it
        rows.each(function (index, row) {
            if (!validateItemReceivedTableRow(row)) {
                allRowsValid = false;
                // You can add your own validation logic here or display an error message.

            }
        });

        return allRowsValid;
    }
    function validateItemReceivedTableRow(row) {
        var isValid = true;

        // Loop through each input and textarea in the row
        $(row).find('input[type="text"], input[type="number"], select').each(function () {
            if ($(this).val() === '') {
                isValid = false;
                return false; // Stop the loop if any field is empty.
            }
            if ($(this).is('select')) {
                if ($(this).val() === '--select--') {
                    isValid = false;
                    return false; // Stop the loop if the value is "--select--".
                }
            }
        });
        return isValid;
    }

    // ================= Quick-add grid (multiple new PRs, one row per item) =================
    // PR Date / Project Name / User Code are shared across every row here - each row only holds
    // what actually varies per PR: Item, Size, Spec/MOC, Qty, Unit, Date Required, Remark, Drawing.
    // Each row saves independently via its own Save button, hitting the same PRSave endpoint
    // SaveData() uses for a single PR.

    function QuickAddBuildItemOptionsHtml(selected) {
        var s = '<option value="">--Select--</option>';
        for (var i = 0; i < ItemNamesList.length; i++) {
            var isSelected = (ItemNamesList[i] === selected) ? ' selected' : '';
            s += '<option value="' + ItemNamesList[i] + '"' + isSelected + '>' + ItemNamesList[i] + '</option>';
        }
        return s;
    }

    // Re-renders the Item <select> in every currently-rendered row once ItemNamesList arrives
    // (GetItemNames resolves after the grid's first blank row is usually already on screen),
    // keeping whatever that row already had selected.
    function QuickAddRefreshItemOptions() {
        $('#QuickAddPRTable tbody tr').each(function () {
            var select = $(this).find('.QAItem');
            select.html(QuickAddBuildItemOptionsHtml(select.val()));
        });
    }

    function QuickAddNewRow() {
        qaRowSeq++;
        var newRow = $('<tr>').attr('data-qarow', qaRowSeq).html(
            '<td><select class="form-control QAItem">' + QuickAddBuildItemOptionsHtml('') + '</select></td>' +
            '<td><input type="text" class="form-control QANewItem" placeholder="New Item"></td>' +
            '<td><input type="text" class="form-control QASize" placeholder="Size"></td>' +
            '<td><input type="text" class="form-control QASpecs" placeholder="Spec/MOC"></td>' +
            '<td><input type="number" min="0" step=".01" class="form-control QAQuantity" placeholder="Qty"></td>' +
            '<td><select class="form-control QAUnit">' +
                '<option value="">--Select--</option>' +
                '<option value="Kgs">Kgs</option>' +
                '<option value="Nos">Nos</option>' +
                '<option value="Dozen">Dozen</option>' +
                '<option value="Metres">Metres</option>' +
                '<option value="Feet">Feet</option>' +
                '<option value="Litres">Litres</option>' +
                '<option value="Sets">Sets</option>' +
            '</select></td>' +
            '<td><input type="text" autocomplete="off" readonly="readonly" class="form-control QADateRequired" placeholder="Select Date"></td>' +
            '<td><input type="text" class="form-control QARemark" placeholder="Remark"></td>' +
            '<td><input type="text" class="form-control QADrawing" placeholder="Drawing"></td>' +
            '<td class="text-nowrap">' +
                '<button type="button" class="btn btn-success btn-xs" onclick="QuickAddSaveRow(this);" title="Save this PR"><span class="glyphicon glyphicon-floppy-disk"></span></button> ' +
                '<button type="button" class="btn btn-danger btn-xs" onclick="QuickAddDeleteRow(this);" title="Remove this row"><span class="glyphicon glyphicon-trash"></span></button>' +
            '</td>'
        );

        $('#QuickAddPRTable tbody').append(newRow);
        newRow.find('.QADateRequired').datepicker({ dateFormat: "dd-mm-yy" });
        return newRow;
    }

    function QuickAddEnsureAtLeastOneRow() {
        if ($('#QuickAddPRTable tbody tr').length === 0) {
            QuickAddNewRow();
        }
    }

    function QuickAddResetGrid() {
        $('#QuickAddPRTable tbody').empty();
        QuickAddNewRow();
    }

    // Validates the row plus the shared header fields above the grid - returns a list of the
    // missing/invalid field labels (empty list = row is ready to save).
    function QuickAddValidateRow(row) {
        var messages = [];

        if ($('#UserCode').val() == '') messages.push('User Code');
        if ($('#PRDate').val() == '') messages.push('PR Date');
        if ($('#ProjectRefDropdown').val() == '') messages.push('Project Name');

        var item = row.find('.QAItem').val();
        var newItem = row.find('.QANewItem').val();
        if (item == '' && newItem == '') messages.push('Item');

        if (row.find('.QASize').val() == '') messages.push('Size');
        if (row.find('.QASpecs').val() == '') messages.push('Spec/MOC');

        var qty = row.find('.QAQuantity').val();
        if (qty == '') messages.push('Quantity');
        else if (!$.isNumeric(qty)) messages.push('Quantity is not numeric');

        if (row.find('.QAUnit').val() == '') messages.push('Unit of Measurement');
        if (row.find('.QADateRequired').val() == '') messages.push('Date Required');

        return messages;
    }

    function QuickAddShowRowError(row, text) {
        row.nextAll('.qa-row-error').first().remove();
        row.after($('<tr class="qa-row-error">').html('<td colspan="10"><div class="ui-error">' + text + '</div></td>'));
    }

    function QuickAddSaveRow(btn) {
        var row = $(btn).closest('tr');
        row.nextAll('.qa-row-error').first().remove();

        var messages = QuickAddValidateRow(row);
        if (messages.length > 0) {
            QuickAddShowRowError(row, '* Please fill: ' + messages.join(', '));
            return;
        }

        var payload = {
            UserCode: $('#UserCode').val(),
            PRDate: $('#PRDate').val(),
            ProjectRefDropdown: $('#ProjectRefDropdown').val(),
            ItemDropdown: row.find('.QAItem').val(),
            NewItem: row.find('.QANewItem').val(),
            ItemSize: row.find('.QASize').val(),
            Specs: row.find('.QASpecs').val(),
            Quantity: row.find('.QAQuantity').val(),
            Unit: row.find('.QAUnit').val(),
            DateRequired: row.find('.QADateRequired').val(),
            Remark: row.find('.QARemark').val(),
            Drawing: row.find('.QADrawing').val()
        };

        row.find('button').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("PRSave","PurchaseRequisition")',
            type: 'POST',
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: payload,
            success: function (data) {
                if (!data || data.Result == 'Error' || data.Result == 'Record Not Found' || (data.Result && data.Result.indexOf('Error') >= 0)) {
                    QuickAddShowRowError(row, data ? data.Result : 'Error saving this PR');
                    row.find('button').prop('disabled', false);
                    return;
                }
                PRAddToTable(data.PRNo, data.ItemDropdown, data.Quantity, data.ItemSize, data.Unit, data.Specs, data.PRDate, data.DateRequired, data.Remark, data.IsAllItemReceived, '');
                refreshPRTableFilterDropdowns();
                row.nextAll('.qa-row-error').first().remove();
                row.remove();
                QuickAddEnsureAtLeastOneRow();
            },
            error: function (ex) {
                console.log(ex);
                QuickAddShowRowError(row, 'Error saving this PR. Please try again.');
                row.find('button').prop('disabled', false);
            }
        });
    }

    function QuickAddDeleteRow(btn) {
        var row = $(btn).closest('tr');
        row.nextAll('.qa-row-error').first().remove();
        row.remove();
        QuickAddEnsureAtLeastOneRow();
    }

</script>


