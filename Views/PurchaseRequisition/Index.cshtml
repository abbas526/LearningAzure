            "<td><input type='text' style='width: 12em' id='" + "ItemReceivedChallanNo_" + Id + "'/>" + "</td>" +
            "<td><input type='text' class='RecDate' style='width: 7em' size='8' id='" + "ItemReceivedDate_" + Id + "'/>" + "</td>" +
            "<td><select size='2' style='width: 7em' size='8' id='" + "ItemReceivedOK_" + Id + "'>" + "<option value='Ok' selected>Ok</option><option value='Not Ok' >Not Ok</option></select></td>" +
            "<td><textarea rows=2 cols=20 id='" + "ItemReceivedComment_" + Id + "'/>" + "</textarea>" +
            "<td>" + (Id === 1 ? "<select class='vendorclass' style='width: 18em' id='" + "Vendor_" + Id + "'></select>" : "") + "</td>" +
            "<td><input type='button' class='delete-button' value='Delete' style='width: 7em' size='8' id='" + "delete_" + Id + "' onclick='DeleteItem(" + Id + ")'/></td>" +
            "</tr>");

        // Append the new row to the table body
        $("#ItemReceivedTable tbody").append(newRow);

        // Populate the dropdown with project names
        var vendorDropdown = newRow.find(".vendorclass");

        // Create a new option element for "--Select--"
