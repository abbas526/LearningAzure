        vendorDropdown.append(selectOption);

        for (var i = 0; i < VendorList.length; i++) {
            //projectDropdown.append($("<option>").text(ProjectNames[i]));
            var vendorName = VendorList[i];
            vendorDropdown.append($("<option>", {
                value: vendorName,  // Set the value equal to the text
                text: vendorName    // Set the text to the same value
            }));
        }
        $('#delete_1').hide();
        $('.RecDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
    }

    function FillItemsArray() {
        var items = new Array();
        var ct = 1;
        $("#ItemReceivedTable tbody tr").each(function () {
            var row = $(this);
            var item = {};
            item.ItemReceivedChallanNo = row.find('#ItemReceivedChallanNo_' + ct).val();
            item.ItemReceivedDate = row.find("#ItemReceivedDate_" + ct).val();
            item.ItemReceivedOK = row.find("#ItemReceivedOK_" + ct).val();
            item.ItemReceivedComment = row.find("#ItemReceivedComment_" + ct).val();
            item.Vendor = $("#Vendor_" + 1).val();
            item.PRNumber = $('#PRNo').val();
            items.push(item);
            ct = ct + 1;
        });

        // Check for duplicates
        if (hasDuplicateChallanNo(items)) {
            alert("Error: Duplicate values found in Challan No.");
            return false;
        }

        return items;
    }


    function hasDuplicateChallanNo(items) {
        var seenChallanNos = {};

        for (var i = 0; i < items.length; i++) {
            var challanNo = items[i].ItemReceivedChallanNo;

            if (seenChallanNos[challanNo]) {
                return true; // Duplicate found
            }

            seenChallanNos[challanNo] = true;
        }

        return false; // No duplicates found
    }

    function SaveItemReceivedData() {



        $('#ItemReceivedErrorMessage').html("");

        if ($('#PRNo').val() == 'undefined' || $('#PRNo').val() == '') {
            $('#ItemReceivedErrorMessage').html("* <b>Please select PR No for Item Received</b>");
            return false;
        }

        var rowCount = $("#ItemReceivedTable tbody tr").length;
        if (rowCount == 0) {
            $('#ItemReceivedErrorMessage').html("* <b>Please select PR No and click on Search Icon</b>");
            return false;
        }

        if (ValidateItemReceivedRows() == false) {
            $('#ItemReceivedErrorMessage').html("* <b>Please fill all values in all rows in Item Received section</b>");
            return false;
        }

        if ($('input[name="IsAllItemReceived"]:checked').length === 0) {
            $('#ItemReceivedErrorMessage').html("* <b>Please select Yes/No if all Item's Received</b>");
            return false;
        }

        var itemReceivedList = FillItemsArray();
        debugger;
        console.log(itemReceivedList);
        var isAllItemReceived = $('input[name="IsAllItemReceived"]:checked').val();

       if (itemReceivedList.length > 0) {
           console.log(itemReceivedList);
           itemReceivedList = JSON.stringify({ 'itemReceivedList': itemReceivedList, IsAllItemReceived: isAllItemReceived });

            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: '@Url.Action("ItemReceivedSave", "PurchaseRequisition")',
                data: itemReceivedList,
                success: function () {
                    $('#errormessage').html("");
                    $("#message").text('Record Saved Successfully');
                    alert('Record Saved Successfully');
                    if (isAllItemReceived === 'yes') {
                        $('input[name="IsAllItemReceived"][value="yes"]').prop('checked', true);
                        $('input[name="IsAllItemReceived"][value="no"]').prop('disabled', true);
                        $('#btnAddItem').prop('disabled', true);
                    }
                    setTimeout(function() { $("#message").hide(); }, 5000);
                },
                failure: function (response) {
                    alert("Error");
                }
            });
        }
    }

    function DeleteItem(id) {
        // Ask for confirmation before deleting
        var confirmation = window.confirm("Are you sure you want to delete this challan?");

        if (confirmation) {
            // Remove the row with the corresponding ID
            $("#ItemReceivedChallanNo_" + id).closest("tr").remove();
        }
    }

    function ValidateItemReceivedRows() {
        // Get all the rows in the table's tbody
        var rows = $("#ItemReceivedTable tbody tr");

        // Initialize a flag to track if all rows are valid
        var allRowsValid = true;

        // Loop through each row and validate it
        rows.each(function (index, row) {
            if (!validateItemReceivedTableRow(row)) {
                allRowsValid = false;
                // You can add your own validation logic here or display an error message.

            }
        });

        return allRowsValid;
    }
    function validateItemReceivedTableRow(row) {
        var isValid = true;

        // Loop through each input and textarea in the row
        $(row).find('input[type="text"], input[type="number"], select').each(function () {
            if ($(this).val() === '') {
                isValid = false;
                return false; // Stop the loop if any field is empty.
            }
            if ($(this).is('select')) {
                if ($(this).val() === '--select--') {
                    isValid = false;
                    return false; // Stop the loop if the value is "--select--".
                }
            }
        });
        return isValid;
    }

</script>


