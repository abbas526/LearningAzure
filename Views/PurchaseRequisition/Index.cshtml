                                <option value="">--Select--</option>
                                <option value="Kgs">Kgs</option>
                                <option value="Nos">Nos</option>
                                <option value="Dozen">Dozen</option>
                                <option value="Metres">Metres</option>
                                <option value="Feet">Feet</option>
