@{
    ViewBag.Title = "Index";
    // Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
    // older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
    // instead of silently keeping stale styling until a manual hard refresh.
    var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>

<script src="~/Scripts/form-validation.js"></script>

<script>
    var Id = 0;
    var ProjectNames;
    $(document).ready(function () {

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetVendorNames","OutgoingChallan")',
            success: function (data) {
                var s = '<option value="">Please Select</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                }
                $("#Vendor").html(s);
            }
        });

        $.ajax({
            type: "GET",
              url: '@Url.Action("GetCompanyNames","PurchaseOrder")',
               success: function (data) {
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   $("#Company").html(s);
               }
        });
        $('#ChallanDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#ReceivedDate').datepicker({
            dateFormat: "dd-mm-yy",
        });

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetProjectNames","PurchaseOrder")',
            success: function (data) {
                ProjectNames = data;
                PRAddToTable();

               }
        });

         // Add the first row by default
    });

    // Renumbers the "#" column so every row shows its current position - called after any
    // insert or removal, rather than trying to compute the right number at insert time.
    function RenumberPRTable() {
        $('#PRTable tbody tr').each(function (idx) {
            $(this).find('td').eq(0).text(idx + 1);
        });
    }

    function AddNew() {
        var c = $('#Company').val();
        if (c == '') {
            alert('Please select Company before adding new challan.');
            return;
        }
        ClearScreen();
        $('#Company').val(c);
        $.ajax({
            url: '/OutgoingChallan/GenerateChallanNo',
            type: 'GET',
            data: { Company: $("#Company").val() },
            success: function (data) {
                // Populate the form fields with data from the controller
                $('#ChallanNumber').val(data.ChallanNumber);
            },
            error: function () {
                alert('Error fetching Challan Number.');
            }
        });


    }
    function PRAddToTable() {
        Id = Id + 1;
        var newRow = $("<tr>" +
            "<td class='row-num'></td>" +
            "<td><textarea class='form-control' style='width: 20em' id='" + "ItemDescription_" + Id + "'></textarea></td>" +
            "<td><input type='text' class='form-control' style='width: 7em' id='" + "HSN_" + Id + "'/>" + "</td>" +
            "<td><input type='number' class='form-control' style='width: 7em' size='8' id='" + "Quantity_" + Id + "' onblur='CalculateAmount(" + Id + ");'/>" + "</td>" +
            "<td><input type='number' class='form-control' style='width: 7em' size='8' id='" + "Rate_" + Id + "' onblur='CalculateAmount(" + Id + ");'/>" + "</td>" +
            "<td><div class='amount-cell'>" +
            "<input type='number' class='form-control' disabled='true' step='0.01' style='width: 7em' size='8' id='" + "Amount_" + Id + "'/>" +
            "<a href='#' onclick='CalculateAmount(" + Id + ");' title='Amount Calculator'><span class='glyphicon glyphicon-usd'></span></a>" +
            "</div></td>" +
            "<td><select class='form-control' style='width: 18em' id='" + "ProjectName_" + Id + "'></select></td>" +
            "<td><button type='button' class='delete-button btn btn-danger btn-xs' id='" + "delete_" + Id + "' onclick='DeleteItem(" + Id + ")'><span class='glyphicon glyphicon-trash'></span>Delete</button></td>" +
            "</tr>");

        // Append the new row to the table body
        $("#PRTable tbody").append(newRow);



        // Populate the dropdown with project names
        var projectDropdown = newRow.find("select");

        // Create a new option element for "--Select--"
        var selectOption = $("<option>", {
            value: "",
            text: "--Select--"
        });

        // Append the option to the select element
        projectDropdown.append(selectOption);

        for (var i = 0; i < ProjectNames.length; i++) {
            //projectDropdown.append($("<option>").text(ProjectNames[i]));
            var projectName = ProjectNames[i];
            projectDropdown.append($("<option>", {
                value: projectName,  // Set the value equal to the text
                text: projectName    // Set the text to the same value
            }));
        }
        RenumberPRTable();
    }

    function DeleteItem(id) {

        // Ask for confirmation before deleting
        var confirmation = window.confirm("Are you sure you want to delete this item?");

        if (confirmation) {
            // Remove the row with the corresponding ID
            $("#ItemDescription_" + id).closest("tr").remove();
            RenumberPRTable();
        }
    }

    function CalculateAmount(Id) {
        var quantity = parseFloat($("#Quantity_" + Id).val());
        var rate = parseFloat($("#Rate_" + Id).val());
        var amount = isNaN(quantity) || isNaN(rate) ? 0 : quantity * rate;
        amount = amount.toFixed(2);
        // Update the Amount field for the particular row
        $("#Amount_" + Id).val(amount);
    }

    function FillItemsArray() {
        var outgoingChallanItems = new Array();
        var challanNumber = $('#ChallanNumber').val();
        // Read each row's fields relative to that row (by field, not by rebuilding
        // "<Field>_<n>" from a counter that starts at 1 every time). The counter used
        // to assume DOM row order always lines up with the "Id" suffix each field was
        // created with, but that "Id" is a page-lifetime counter that never resets
        // (ClearScreen/AddNew don't reset it) and skips numbers whenever a row is
        // deleted - so after loading a challan, deleting a row, or starting a second
        // new challan without a full page refresh, the reconstructed id pointed at
        // nothing, row.find() returned an empty set, .val() came back undefined, and
        // JSON.stringify silently dropped that field - saving blank items.
        $("#PRTable tbody tr").each(function () {
            var row = $(this);
            var outgoingChallanItem = {};
            outgoingChallanItem.ChallanNumber = challanNumber;
            outgoingChallanItem.ItemDescription = row.find("textarea[id^='ItemDescription_']").val();
            outgoingChallanItem.HSN = row.find("input[id^='HSN_']").val();
            outgoingChallanItem.Quantity = row.find("input[id^='Quantity_']").val();
            outgoingChallanItem.Rate = row.find("input[id^='Rate_']").val();
            outgoingChallanItem.Amount = row.find("input[id^='Amount_']").val();
            outgoingChallanItem.ProjectName = row.find("select[id^='ProjectName_']").val();
            outgoingChallanItems.push(outgoingChallanItem);
        });
        console.log(outgoingChallanItems);

        return outgoingChallanItems;
    }

   function ChallanItemsSave() {

       var challanItems = FillItemsArray();

       if (challanItems.length > 0) {
           console.log(challanItems);
           challanItems = JSON.stringify({ 'challanItems': challanItems });

            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: '@Url.Action("ChallanItemSave","OutgoingChallan")',
                data: challanItems,
                success: function () {
                    $('#errormessage').html("");
                    $("#message").text('Record Saved Successfully');
                    alert('Record Saved Successfully');
                    setTimeout(function() { $("#message").hide(); }, 5000);
                },
                failure: function (response) {
                    alert("Error");
                }
            });
        }
    }

    function ChallanSave() {
            //Serialize the form datas.
        if (ValidateForm() == false) { return false; }

        var valdata = $("#ChallanForm").serialize();
        var POSaveSuccess = true;
        // Save PO
        $.ajax({
            url: '@Url.Action("ChallanSave", "OutgoingChallan")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data != 'Success') {
                    alert(data);
                }
                else {
                    ChallanItemsSave();
                }
            },
            failure: function (response) {
                alert("Error");
            }
        });
        if (POSaveSuccess == false) {
            return false;
        }

    }

    function ValidateForm() {

        var valid = true;
        var message = "";

        if ($('#ChallanNumber').val() == "") {
            message += 'Challan Number' + '<br>';
        }
        if ($('#ChallanDate').val() == "") {
            message += 'ChallanDate' + '<br>';
        }
        if ($('#Company').val() == "") {
            message += 'Company' + '<br>';
        }
        if ($('#Vendor').val() == "") {
            message += 'Vendor' + '<br>';
        }
        if ($('#VehicleNumber').val() == "") {
            message += 'Vehicle Number' + '<br>';
        }
		if ($('#ValueOfMaterial').val() === "") { //ValueOfMaterial
            message += 'Value Of Material' + '<br>';
        }
		if ($('#ValueOfMaterial').val() !== "" && parseFloat($('#ValueOfMaterial').val()) >= 50000) {
			if ($('#EWayBillNo').val() === "") {
				message += 'EWay Bill NO' + '<br>';
			}
		}
        if (message != "") {

            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {
            if (ValidateRows() == false) {
                $('#errormessage').html("* <b>Please fill all values in all rows</b>");
                return false;
            }
            $('#errormessage').html();
        }
        return true;
    }

    function ValidateRows() {
        // Get all the rows in the table's tbody
        var rows = $("#PRTable tbody tr");

        // Initialize a flag to track if all rows are valid
        var allRowsValid = true;

        // Loop through each row and validate it
        rows.each(function (index, row) {
            if (!validateTableRow(row)) {
                allRowsValid = false;
                // You can add your own validation logic here or display an error message.

            }
        });

        return allRowsValid;
    }
    function validateTableRow(row) {
        var isValid = true;

        // Loop through each input and textarea in the row
        $(row).find('input[type="text"], input[type="number"], textarea,select').each(function () {
            if ($(this).val() === '') {
                isValid = false;
                return false; // Stop the loop if any field is empty.
            }
            if ($(this).is('select')) {
                if ($(this).val() === '--select--') {
                    isValid = false;
                    return false; // Stop the loop if the value is "--select--".
                }
            }
        });
        return isValid;
    }
    function LoadData() {
        $.ajax({
            url: '/OutgoingChallan/GetChallan', // Replace with the actual URL of your MVC Controller action
            type: 'GET',
            data: { challanNumber: $("#ChallanNumber").val() },
            success: function (data) {
                if (data.Result.includes('Error')) {
                    alert(data.Result);
                    ClearScreen();
                    return;
                }
                // Populate the form fields with data from the controller
                $('#ChallanNumber').val(data.ChallanNumber);
                $('#ChallanDate').val(data.ChallanDate);
                $('#Company').val(data.Company);
                $('#Vendor').val(data.Vendor);
                $('#VehicleNumber').val(data.VehicleNumber);
                $('#EWayBillNo').val(data.EWayBillNo);
                $('#Comment').val(data.Comment);
                $('#ReceivedDate').val(data.ReceivedDate);
                $('#ReceivedComment').val(data.ReceivedComment);
                $('#ValueOfMaterial').val(data.ValueOfMaterial);
				$('#VendorGST').text(data.VendorGST);
                // Populate the table with data from the controller
                var tbody = $('#PRTable tbody');
                tbody.empty(); // Clear existing rows
                var ctr = 1;
                $.each(data.OutgoingChallanItems, function (index, item) {
                    var newRow = $('<tr>');
                    newRow.append($('<td>').addClass('row-num'));
                    newRow.append($('<td>').html('<textarea class="form-control" style="width: 20em" Id="ItemDescription_' + ctr + '" rows="3">' + item.ItemDescription + '</textarea>'));
                    newRow.append($('<td>').html('<input type="text" class="form-control" style="width: 7em"  Id="HSN_' + ctr + '" value="' + item.HSN  + '"/>'));
                    newRow.append($('<td>').html('<input type="Number" class="form-control" size="8" style="width: 7em" Id="Quantity_' + ctr + '" value="' + item.Quantity + '" onblur="CalculateAmount(' + ctr + ');"/>'));
                    newRow.append($('<td>').html('<input type="Number" class="form-control" size="8" style="width: 7em" Id="Rate_' + ctr + '" value="' + item.Rate + '" onblur="CalculateAmount(' + ctr + ');"/>'));
                    newRow.append($('<td>').html('<div class="amount-cell"><input type="number" class="form-control" size="8" style="width: 7em" Id="Amount_' + ctr + '" disabled="true" value="' + item.Amount + '"/>'
                        + '<a href="#" onclick="CalculateAmount(' + ctr + ');" title="Amount Calculator"><span class="glyphicon glyphicon-usd"></span></a></div>'));
                    newRow.append($('<td>').html('<select class="form-control" style="width: 18em" Id="ProjectName_' + ctr + '" />'));
                    newRow.append($('<td>').html('<button type="button" class="delete-button btn btn-danger btn-xs" onclick="DeleteItem('+ctr+')" Id=delete_' + ctr + '><span class="glyphicon glyphicon-trash"></span>Delete</button>'   ));
                    tbody.append(newRow);

                    var projectDropdown = newRow.find("select");

                    for (var i = 0; i < ProjectNames.length; i++) {
                        //projectDropdown.append($("<option>").text(ProjectNames[i]));
                        var projectName = ProjectNames[i];

                        if (projectName === item.ProjectName) {
                            projectDropdown.append($("<option>", {
                                value: projectName,  // Set the value equal to the text
                                text: projectName,    // Set the text to the same value
                                selected: true
                            }));
                        }
                        else {
                            projectDropdown.append($("<option>", {
                                value: projectName,  // Set the value equal to the text
                                text: projectName    // Set the text to the same value
                            }));
                        }
                    }

                    ctr = ctr + 1;
                });
                Id = ctr-1;
                RenumberPRTable();
            },
            error: function () {
                alert('Error fetching data from the controller.');
            }
        });


    }
    function PrintChallan() {
        if ($('#ChallanNumber').val() == 'undefined' || $('#ChallanNumber').val() == '') {
            alert('Please Enter a valid Challan Number');
            return;
        }
        var url = '@Url.Action("PrintChallan", "OutgoingChallan",new { challanNumber = "challan_number"})';
        url = url.replace("challan_number", $('#ChallanNumber').val());
        window.open(url,"_blank","top=20, left=20, scrollbars=yes width=800, height=500");
    }

    function ClearScreen() {
        $('#VendorGST').text('');
        // Clear textboxes and textareas
        $('input[type="text"], textarea').val('');
        $('input[type="number"]').val('');
        // Select the first option in dropdowns
        $('select').prop('selectedIndex', 0);

        // Uncheck checkboxes
        $('input[type="checkbox"]').prop('checked', false);

        // Unselect radio buttons
        $('input[type="radio"]').prop('checked', false);

        // Remove all rows except the first one in the table with the ID "mytable"
        $('#PRTable tr:gt(1)').remove();

        // Clear all textboxes in the first row
        $('#PRTable tr:first input[type="text"]').val('');
        $('#PRTable tr:first input[type="number"]').val(null);
        // Reset dropdown values to the first option in the first row
        $('#PRTable tr:first').prop('selectedIndex', 0);
        RenumberPRTable();
    }

    function LoadGST() {
		$.ajax({
			url: '/OutgoingChallan/GetVendorGST', // Replace with the actual URL of your MVC Controller action
			type: 'GET',
			data: { vendorName: $("#Vendor").val() },
            success: function (data) {

                $('#VendorGST').text(data);
			},
			error: function () {
				alert('Error fetching data from the controller.');
			}
		});
	}
</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-send"></span>Outgoing Challan Details
    </div>

    <form class="form-horizontal" role="form" name="ChallanForm" id="ChallanForm" autocomplete="off">

        <!-- ================= Search / Manage Challan ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-search"></span>Find Challan</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ChallanNumber" class="form-label required">Challan Number</label>
                        <div class="input-group">
                            <input type="text" id="ChallanNumber" required="required" autocomplete="off" name="ChallanNumber" data-required="true" placeholder="Challan Number" class="form-control ui-input-md" autofocus>
                            <span class="input-group-btn">
                                <button class="btn btn-info" type="button" onclick="LoadData();" title="Load this Challan">
                                    <span class="glyphicon glyphicon-search"></span>Load
                                </button>
                                <button class="btn btn-default" type="button" onclick="PrintChallan();" title="Print Challan">
                                    <span class="glyphicon glyphicon-print"></span>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div style="display:flex; align-items:center; gap:15px;">
                        <button type="button" id="ClearButton" name="ClearButton" class="btn btn-default" onclick="ClearScreen();" title="Clear everything and return to a fresh screen">
                            <span class="glyphicon glyphicon-erase"></span>Clear All
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Challan Details ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title" style="display:flex; align-items:center;">
                <span class="glyphicon glyphicon-list-alt"></span>Challan Details
                <button type="button" id="AddNewButton" name="AddNewButton" class="btn btn-default btn-sm" style="margin-left:28px;" onclick="AddNew();" title="Generate a new Challan Number for the selected Company and start a fresh Challan">
                    <span class="glyphicon glyphicon-plus"></span>New Challan
                </button>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Company" class="form-label required">Company</label>
                        <select name="Company" id="Company" class="form-control" required="required">
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ChallanDate" class="form-label required">Challan Date</label>
                        <input type="text" name="ChallanDate" id="ChallanDate" autocomplete="off" readonly="readonly" required="required" placeholder="Select Date" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Vendor" class="form-label required">Vendor Name</label>
                        <select class="form-control" id="Vendor" name="Vendor" required="required" onchange="LoadGST();"></select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Vendor GST</label>
                    <div>
                        <span id="VendorGST" name="VendorGST" class="ui-badge"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="VehicleNumber" class="form-label required">Vehicle Number</label>
                        <input type="text" name="VehicleNumber" id="VehicleNumber" required="required" placeholder="Vehicle Number" class="form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="EWayBillNo" class="form-label">EWay Bill No</label>
                        <input type="text" id="EWayBillNo" name="EWayBillNo" placeholder="EWay Bill No" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Comment" class="form-label">Comment</label>
                        <textarea rows="3" name="Comment" id="Comment" placeholder="Comment" class="form-control"></textarea>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ValueOfMaterial" class="form-label required">Value of Material</label>
                        <input type="number" id="ValueOfMaterial" name="ValueOfMaterial" required="required" placeholder="Value Of Material" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Items for this Challan ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-th-list"></span>Items for this Challan</div>

            <div class="table-responsive">
                <table id="PRTable" name="PRTable" class="table table-bordered table-condensed table-striped ui-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item Description</th>
                            <th>HSN</th>
                            <th>Quantity</th>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Project Name</th>
                            <th style="width:110px;">
                                <button type="button" class="btn btn-success btn-xs" id="btnAddItem" name="btnAddItem" onclick="PRAddToTable()">
                                    <span class="glyphicon glyphicon-plus"></span>Add Item
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= Item(s) Received ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-inbox"></span>Item(s) Received</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ReceivedDate" class="form-label">Item(s) Received Date</label>
                        <input type="text" id="ReceivedDate" name="ReceivedDate" autocomplete="off" readonly="readonly" placeholder="Select Date" class="form-control">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ReceivedComment" class="form-label">Notes for Items Received</label>
                        <textarea rows="2" name="ReceivedComment" id="ReceivedComment" class="form-control"></textarea>
                    </div>
                </div>
            </div>

            <div class="row ui-card-footer">
                <div class="col-md-12">
                    <div id="message" name="message"></div>
                </div>
            </div>
            <div id="errormessage"></div>
        </div>

        <!-- ================= Save / Print / Clear - deliberately outside the card above: it acts on
              the whole Challan, not just the Item(s) Received fields ================= -->
        <div class="row mt-3 mb-4" style="text-align:center;">
            <button type="button" id="btnSave" name="btnSave" class="btn btn-primary" onclick="ChallanSave();">
                <span class="glyphicon glyphicon-floppy-disk"></span>Save All
            </button>
            &nbsp;&nbsp;
            <button type="button" id="PrintButton" name="PrintButton" class="btn btn-default" onclick="PrintChallan();">
                <span class="glyphicon glyphicon-print"></span>Print
            </button>
            &nbsp;&nbsp;
            <button type="button" id="ClearAllButton" name="ClearAllButton" class="btn btn-default" onclick="ClearScreen();">
                <span class="glyphicon glyphicon-erase"></span>Clear All
            </button>
        </div>
    </form>
</div>
