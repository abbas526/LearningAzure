@model OrientalApplication.Models.ChallanPrintViewModel
@{
    Layout = null;
}
<html>
<head>
    <link href="~/Content/PrintChallan_Professional.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.4.1.js"></script>
</head>
<body>
    <div class="challan-toolbar">
        <button type="button" id="printIconButton" class="challan-icon-button" onclick="printTwoCopies()" title="Print">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
        </button>
        <button type="button" id="closeButton" class="challan-close-button" onclick="window.close()" title="Close this window">&times; Close</button>
    </div>
    @{
        var companyName = Model.POCompany.CompanyName;
        var isFabritech = companyName.ToLower().Contains("fabritech");
        var color = isFabritech ? "rgb(31, 36, 102)" : "rgb(245, 129, 28)";
    }
    <div class="challan-page">

        <div class="challan-letterhead">
            <div class="challan-letterhead-cell challan-letterhead-logo">
                @if (isFabritech)
                {
                    <img src="~/Images/LogoFab.png" width="53" height="50" />
                }
                else
                {
                    <img src="~/Images/Logo.jpg" width="57" height="65" />
                }
            </div>
            <div class="challan-letterhead-cell">
                <div class="challan-company-name" style="color: @color !important;">@Model.POCompany.CompanyName</div>
            </div>
            <div class="challan-letterhead-cell challan-letterhead-logo challan-letterhead-logo-right">
                <img src="~/Images/Austria.jpg" width="50" height="50" />
            </div>
        </div>

        <div class="challan-accent-rule" style="background: @color !important;"></div>

        <div class="challan-corporate-address">
            <b>Reg. Office:</b> 208 Comet, Guru Nanak Road, Bandra (West), Mumbai  400050.
        </div>
        <div class="challan-corporate-address">
            <b>Works:</b> @Model.POCompany.CompanyAddress
        </div>
        <div class="challan-corporate-address">
            <b>GSTIN No:</b> @Model.POCompany.GSTNo
        </div>

        <div class="challan-title-band">
            <div class="challan-title-band-cell">
                <span class="challan-title" style="color: @color !important;">Delivery Challan</span>
            </div>
            <div class="challan-title-band-cell challan-meta">
                <div class="challan-meta-row"><span class="challan-meta-label">Date:</span><span class="challan-meta-value">@Model.Challan.ChallanDate</span></div>
                <div class="challan-meta-row"><span class="challan-meta-label">Challan No:</span><span class="challan-meta-value">@Model.Challan.ChallanNumber</span></div>
            </div>
        </div>

        <div class="challan-subtitle">Returnable Goods &nbsp; <span class="challan-copy-type" id="PrintType" name="PrintType"></span></div>

        <div class="challan-line-group">
            <div class="challan-line"><span class="challan-label">Vehicle No: </span>@(Model.Challan.VehicleNumber ?? "")</div>
            <div class="challan-line"><span class="challan-label">EWay Bill No: </span>@(Model.Challan.EWayBillNo ?? "")</div>
        </div>

        <div class="challan-panel">
            <div class="challan-section-label" style="background: @color !important;">Vendor Details</div>
            <div class="challan-panel-body">
                <div class="challan-panel-col">
                    <div><span class="challan-field-label">Vendor: </span><span class="challan-field-value">@(Model.POVendor != null ? Model.POVendor.VendorName : "")</span></div>
                    <div><span class="challan-field-label">Contact Person: </span>@(Model.POVendor != null ? Model.POVendor.ContactPerson : "")</div>
                    <div><span class="challan-field-label">Contact Number: </span>@(Model.POVendor != null ? Model.POVendor.ContactNumber : "")</div>
                    <div><span class="challan-field-label">Email: </span>@(Model.POVendor != null ? Model.POVendor.Email : "")</div>
                </div>
                <div class="challan-panel-col">
                    <div><span class="challan-field-label">Vendor Address: </span>@(Model.POVendor != null ? Model.POVendor.Address : "")</div>
                    <div><span class="challan-field-label">Vendor GST: </span>@(Model.POVendor != null ? Model.POVendor.GST : "")</div>
                    <div><span class="challan-field-label">Vendor MSME: </span>@(Model.POVendor != null ? Model.POVendor.VendorMSME : "")</div>
                </div>
            </div>
        </div>

        <table class="challan-items">
            <thead>
                <tr style="background: @color !important;">
                    <th class="challan-col-center">SL</th>
                    <th>Project</th>
                    <th>Description of Goods</th>
                    <th class="challan-col-center">HSN/SAC</th>
                    <th class="challan-col-center">Quantity</th>
                    <th class="challan-col-right">Rate</th>
                    <th class="challan-col-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var counter = 1;
                }
                @foreach (var x in Model.Challan.OutgoingChallanItems)
                {
                    <tr>
                        <td class="challan-col-center">@counter</td>
                        <td>@x.ProjectName</td>
                        <td>@x.ItemDescription</td>
                        <td class="challan-col-center">@x.HSN</td>
                        <td class="challan-col-center">@x.Quantity</td>
                        <td class="challan-col-right">@x.Rate</td>
                        <td class="challan-col-right">@x.Amount</td>
                    </tr>
                    counter++;
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="challan-total-label">Total</td>
                    <td class="challan-total-amount">@Model.Challan.FinalAmount</td>
                </tr>
            </tfoot>
        </table>

        <div class="challan-line"><span class="challan-label">Value of Material: </span>@(Model.Challan.ValueOfMaterial ?? "")</div>

        <div class="challan-notes">
            <span class="challan-label">Notes</span>: @(Model.Challan.Comment ?? "")
        </div>

        <div class="challan-signoff-note">Please sign &amp; return the duplicate copy.</div>

        <div class="challan-footer">
            <div class="challan-footer-col challan-footer-contact">
                <div><span class="challan-label">Issued By:</span> @Model.POCompany.ContactPerson</div>
                <div>@Model.POCompany.Email</div>
                <div>Contact: @Model.POCompany.ContactPersonNumber</div>
            </div>
            <div class="challan-footer-col challan-signature-block">
                <div class="challan-signature-line">&nbsp;</div>
                <div class="challan-signature-caption">Authorized Signatory &mdash; @Model.POCompany.CompanyName</div>
            </div>
        </div>

        <div class="challan-doc-footnote">This is a system-generated Delivery Challan.</div>

    </div>

    <div class="challan-print-bar">
        <button onclick="printTwoCopies()" id="printButton" name="printButton">Click to Print</button>
    </div>
    <script>
        function printTwoCopies() {
            $('#printButton').hide();

            // Set up a print counter to control the number of copies
            var printCounter = 0;

            // Function to handle the print operation
            function printPage() {
                if (printCounter < 2) {
                    if (printCounter == 0) {
                        $('#PrintType').text("(Original Copy)");
                    }
                    else {
                        $('#PrintType').text("(Duplicate Copy)");
                    }
                    printCounter++;

                    var curURL = window.location.href;
                    history.replaceState(history.state, '', '/');
                    window.print();
                    history.replaceState(history.state, '', curURL);
                }
            }

            // Attach the printPage function as a callback to the afterprint event
            if (window.matchMedia) {
                var mediaQueryList = window.matchMedia('print');
                mediaQueryList.addListener(function (mql) {
                    if (!mql.matches) {
                        printPage();
                    }
                });
            }

            printPage();
        }
    </script>
</body>
</html>
