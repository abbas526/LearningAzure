<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oriental Admin Tool</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* Style for the submenu */
        .submenu {
            display: none;
            position: absolute;
            background-color: #fff; /* Set the background color for the submenu */
            border: 1px solid #ccc; /* Add a border for the submenu */
            z-index: 1; /* Ensure the submenu is displayed above other content */
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

            /* Style for submenu items */
            .submenu li {
                display: block;
                padding: 10px;
            }

        /* Style for the parent menu item on hover */
        .nav li:hover .submenu {
            display: block; /* Show the submenu on hover */
        }

        /* Top navigation bar: swap Bootstrap's default near-black .navbar-inverse for a dark,
           professional green, keeping the link/title text white throughout (not just on hover -
           Bootstrap's default only turns nav links white on hover/active, grey otherwise). */
        .navbar-inverse {
            background-color: #1e4b3a;
            border-color: #123328;
        }

            .navbar-inverse .navbar-brand,
            .navbar-inverse .navbar-nav > li > a {
                color: #ffffff;
            }

                .navbar-inverse .navbar-brand:hover,
                .navbar-inverse .navbar-brand:focus,
                .navbar-inverse .navbar-nav > li > a:hover,
                .navbar-inverse .navbar-nav > li > a:focus {
                    color: #ffffff;
                    background-color: #163a2d;
                }

            .navbar-inverse .navbar-nav > .active > a,
            .navbar-inverse .navbar-nav > .active > a:hover,
            .navbar-inverse .navbar-nav > .active > a:focus,
            .navbar-inverse .navbar-nav > .open > a,
            .navbar-inverse .navbar-nav > .open > a:hover,
            .navbar-inverse .navbar-nav > .open > a:focus {
                color: #ffffff;
                background-color: #123328;
            }

            .navbar-inverse .navbar-toggle {
                border-color: #163a2d;
            }

                .navbar-inverse .navbar-toggle:hover,
                .navbar-inverse .navbar-toggle:focus {
                    background-color: #163a2d;
                }

                .navbar-inverse .navbar-toggle .icon-bar {
                    background-color: #ffffff;
                }

            .navbar-inverse .navbar-collapse,
            .navbar-inverse .navbar-form {
                border-color: #123328;
            }

        /* Bootstrap's own .container padding (15px) and .navbar-collapse padding (15px) otherwise
           leave a wide gap both before the logo and between the brand and the first nav link.
           Scoped to this specific navbar's own direct-child container, not the generic .container
           class used elsewhere on the page. */
        .navbar.navbar-inverse > .container {
            /* Bootstrap centers .container with auto left/right margins, which is what pushed the
               logo/title well away from the browser's left edge on wide screens. Left-align it
               instead, with just enough padding to keep the brand off the very edge. */
            margin-left: 0;
            padding-left: 24px;
        }

        .navbar-inverse .navbar-collapse {
            padding-left: 6px;
        }

        /* Logo next to the title, floated left exactly like Bootstrap's own .navbar-brand would be
           (keeps .navbar-toggle's default float:right untouched) - flex + align-items:center just
           centers the image against the h4's own existing height, it doesn't add to it. The image
           is explicitly sized well under the h4's natural rendered height (~40px, from its default
           10px/10px margins + line-height) so the bar's height is unchanged. */
        .navbar-brand-wrap {
            float: left;
            display: flex;
            align-items: center;
        }

        .navbar-logo {
            height: 28px;
            width: auto;
            margin-right: 10px;
        }

        .navbar-brand-wrap h4 {
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="@Url.Content("~/AdminTool.html")" class="navbar-brand-wrap" style="color:inherit; text-decoration:none;" title="Application Summary">
                    <img src="~/Images/Logo.jpg" alt="Oriental" class="navbar-logo" />
                    <h4>Oriental Admin Tool</h4>
                </a>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li>@Html.ActionLink("Purchase Order", "Index", "PurchaseOrder")</li>
                        <li>@Html.ActionLink("Purchase Requisition", "Index", "PurchaseRequisition")</li>
                        <li>@Html.ActionLink("Outgoing Challan", "Index", "OutgoingChallan")</li>
                        <li>@Html.ActionLink("Vendor Payment", "Index", "BillPayment")</li>
                        @*<li>@Html.ActionLink("Vendor", "Index", "Vendor")</li>
            <li>@Html.ActionLink("Project", "Index", "ProjectMaster")</li>
            <li>@Html.ActionLink("Reports", "Index", "Report")</li>
            <li>@Html.ActionLink("Item", "Index", "Item")</li>*@
                        <li class="nav-item-has-submenu">
                            <!-- Add a parent class to this li element -->
                            @Html.ActionLink("More", "Index", "Report")
                            <ul class="submenu">
                                <!-- Create a submenu with the desired options -->
                                <li>@Html.ActionLink("VendorPayment DashBoard", "VendorPaymentDashBoard", "BillPayment")</li>
                                <li>@Html.ActionLink("Vendor", "Index", "Vendor")</li>
                                <li>@Html.ActionLink("Project", "Index", "ProjectMaster")</li>
                                <li>@Html.ActionLink("Reports", "Index", "Report")</li>
                                <li>@Html.ActionLink("Item", "Index", "Item")</li>
                            </ul>
                        </li>
                        <li>@Html.ActionLink("Logout", "Logout", "Accounts")</li>
                    }
                    else
                    {
                        <li>@Html.ActionLink("Login", "Login", "Accounts")</li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="container body-content" id="powered" name="powered">
        @RenderBody()
       
    </div>
</body>
</html>
