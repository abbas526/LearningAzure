<script>
    function ShowSaveSuccess() {
        $("#message").text('Record Saved Successfully');
        alert('Record Saved Successfully');
        setTimeout(function () { $("#message").hide(); }, 5000);
        $('#errormessage').html('');
    }

    function AddData() {
        if ($('#NewProjectName').val() == "") {
            alert('Please enter New Project Name');
            return false;
        }
        //Serialize the form data.
        var valdata = $("#ProjectForm").serialize();
        //to get alert popup
        $.ajax({
            url: '@Url.Action("SaveProject","ProjectMaster")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data.Result.includes('Error')) {
                    alert(data.Result);
                }
                else {
                    ShowSaveSuccess(data.Result);
                }
            },
            error: function (ex) {
                console.log(ex);
            }
        });
    }
    function SaveData() {

        if (ValidateForm() == false) {
            return false;
        }
            //Serialize the form datas.
            var valdata = $("#ProjectForm").serialize();
            //to get alert popup
            $.ajax({
                url: '@Url.Action("SaveProject","ProjectMaster")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data.Result.includes('Error')) {
                        alert(data.Result);
                    }
                    else {
                        ShowSaveSuccess(data.Result);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
        //ShowSaveSuccess();
        //$('#btnSave').prop('disabled', true);
    }

    function ValidateForm() {

	    var message = "";

        if ($('#ProjectName').val() == "")
        {
            message += 'Project Name' + '<br>';
        }
        if ($('#IsActive').val() == "") {
            message += 'IsActive' + '<br>';
        }
        if (message != "") {
            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {
            $('#errormessage').html('');
        }
        return true;
    }

   function LoadData() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetProject", "ProjectMaster")',
            dataType: 'json',
            data: { projectName: $('#ProjectName').val() },
            success: function (data) {
                if (data == 'Not Found') {
                    alert('Project Not found');
                }
                else {
                    $('#ProjectName').val(data.ProjectName);
                    $('#IsActive').val(data.IsActive);
                }

            },
            error: function (ex) {
                alert('Vendor Not Found');
                console.log(ex);
            }

        });
    }

    function CloneProject() {

        if ($('#ProjectName').val() == "") {
            $('#errormessage').html("* <b>Please enter/select a existing project name to copy from</b> <br><br>");
            return false;
        }
        else {
            $('#errormessage').html("");
        }

        let confirmAction = confirm("Are you sure you want to Copy the Project and associated PRs ?");
        if (confirmAction == false) {
            return false;
        }
            //Serialize the form datas.
            var valdata = $("#ProjectForm").serialize();
            //to get alert popup
            $.ajax({
                url: '@Url.Action("CloneProject","ProjectMaster")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data.Result.includes('Error')) {
                        alert(data.Result);
                    }
                    else {
                        ShowSaveSuccess(data.Result);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
        //ShowSaveSuccess();
        //$('#btnSave').prop('disabled', true);
    }

    function UploadPR() {
        if ($('#ProjectName').val() == "") {
            alert('Please enter a existing project name.')
            $('#ProjectName').focus();
            return false;
        }
        var fileUpload = $("#PRFileUpload").get(0);
        var files = fileUpload.files;

        // Create FormData object
        var fileData = new FormData();

        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        // Adding one more key to FormData object
        fileData.append('projectname', $('#ProjectName').val());

        $.ajax({
            url: '/ProjectMaster/UploadPRFile',
            type: "POST",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: fileData,
            dataType: 'json',
            success: function (result) {
                if (result && result.Success && result.NewlyAddedPRs && result.NewlyAddedPRs.length > 0) {
                    RenderUploadedPRTable(result.NewlyAddedPRs);
                }
                else {
                    // Upload failed (or added nothing) - never show/refresh a "newly added" table
                    // for an upload that didn't actually add anything.
                    $('#UploadedPRTable tbody').empty();
                    $('#UploadedPRsSection').hide();
                }
                alert(result && result.Result ? result.Result : result);
            },
            error: function (err) {
                $('#UploadedPRTable tbody').empty();
                $('#UploadedPRsSection').hide();
                alert(err.statusText);
            }
        });
    }

    // Renders ONLY the PRs the most recent bulk upload actually inserted (never the project's
    // full PR list) into the "Newly Added PRs" table below the Bulk PR Upload card - same column
    // layout as the "PRs for Project" table on the Purchase Requisition screen. "All Item Recd" is
    // always "no" here since these rows were just created.
    function RenderUploadedPRTable(newlyAddedPRs) {
        var tbody = $('#UploadedPRTable tbody');
        tbody.empty();
        for (var i = 0; i < newlyAddedPRs.length; i++) {
            var pr = newlyAddedPRs[i];
            tbody.append("<tr>" +
                "<td>" + pr.PRNo + "</td>" +
                "<td>" + pr.Item + "</td>" +
                "<td>" + pr.ItemSize + "</td>" +
                "<td>" + pr.Specs + "</td>" +
                "<td>" + pr.Quantity + "</td>" +
                "<td>" + pr.Unit + "</td>" +
                "<td>" + pr.PRDate + "</td>" +
                "<td>" + pr.DateRequired + "</td>" +
                "<td>" + pr.Remark + "</td>" +
                "<td>no</td>" +
                "</tr>");
        }
        $('#UploadedPRsSection').show();
    }
</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-folder-open"></span>Project Management
    </div>

    <form id="ProjectForm" name="ProjectForm" role="form" autocomplete="off">

        <!-- ================= Existing Project ================= -->
        <div class="ui-card ui-narrow-fields">
            <div class="ui-card-title"><span class="glyphicon glyphicon-search"></span>Existing Project</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ProjectName" class="form-label required">Project Name</label>
                        <div class="input-group">
                            <select class="form-control" id="ProjectName" name="ProjectName"></select>
                            <span class="input-group-btn">
                                <button class="btn btn-info" type="button" onclick="LoadData();" title="Load this project">
                                    <span class="glyphicon glyphicon-search"></span>Load
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="IsActive" class="form-label required">Active</label>
                        <select class="form-control" name="IsActive" id="IsActive">
                            <option value="">--Select--</option>
                            <option value="yes">Yes</option>
                            <option value="no">No</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row ui-card-footer">
                <div class="col-md-6">
                    <div id="message" name="message"></div>
                </div>
                <div class="col-md-6 btn-toolbar-right">
                    <button type="button" id="btnSave" name="btnSave" class="btn btn-primary" onclick="SaveData();">
                        <span class="glyphicon glyphicon-floppy-disk"></span>Save Existing Project
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= Add New Project / Clone Project ================= -->
        <div class="row">
            <div class="col-md-6">
                <div class="ui-card">
                    <div class="ui-card-title"><span class="glyphicon glyphicon-plus"></span>Add New Project</div>

                    <div class="form-group">
                        <label for="NewProjectName" class="form-label">New Project Name</label>
                        <input type="text" id="NewProjectName" name="NewProjectName" placeholder="Enter new project name" class="form-control">
                    </div>

                    <button type="button" id="btnAdd" name="btnAdd" class="btn btn-success btn-block" onclick="AddData();">
                        <span class="glyphicon glyphicon-floppy-disk"></span>Save New Project
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ui-card">
                    <div class="ui-card-title"><span class="glyphicon glyphicon-copy"></span>Clone Project</div>

                    <div class="form-group">
                        <label for="CloneProjectName" class="form-label">New Project Name</label>
                        <input type="text" id="CloneProjectName" name="CloneProjectName" placeholder="Enter cloned project name" class="form-control">
                    </div>

                    <button type="button" id="btnClone" name="btnClone" class="btn btn-warning btn-block" onclick="CloneProject();">
                        <span class="glyphicon glyphicon-copy"></span>Copy Existing Project
                    </button>

                    <div class="ui-error mt-3">
                        This will duplicate all PRs from the selected Project Name above. PR Date and Required Date will default to today.
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Bulk PR Upload ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-upload"></span>Bulk PR Upload</div>

            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="PRFileUpload" class="form-label">Upload File</label>
                        <input type="file" id="PRFileUpload" name="PRFileUpload" class="form-control">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div>
                        <button type="button" id="btnFileUpload" name="btnFileUpload" class="btn btn-info" onclick="UploadPR();">
                            <span class="glyphicon glyphicon-upload"></span>Upload PRs
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="visibility:hidden;">&nbsp;</label>
                    <div class="btn-toolbar-right">
                        <a class="btn btn-default" href="@Url.Action("GetSampleExcel", "ProjectMaster")" title="Download the PR upload template">
                            <span class="glyphicon glyphicon-download-alt"></span>Download Template
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Newly Added PRs (last Bulk Upload) ================= -->
        <div class="ui-card" id="UploadedPRsSection" style="display:none;">
            <div class="ui-card-title"><span class="glyphicon glyphicon-ok-circle"></span>Newly Added PRs (Last Bulk Upload)</div>
            <div class="table-responsive">
                <table id="UploadedPRTable" name="UploadedPRTable" class="table table-bordered table-condensed table-striped ui-table">
                    <thead>
                        <tr>
                            <th>PR #</th>
                            <th>Item</th>
                            <th style="width:15%;">Size</th>
                            <th>MOC</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>PR Date</th>
                            <th>Reqd Date</th>
                            <th>Remarks</th>
                            <th>All Item Recd</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="errormessage"></div>

    </form> <!-- /ProjectForm -->
</div> <!-- ./container -->
