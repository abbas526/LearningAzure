<script>
    function ShowSaveSuccess() {
        $("#message").text('Record Saved Successfully');
        alert('Record Saved Successfully');
        setTimeout(function () { $("#message").hide(); }, 5000);
        $('#errormessage').html('');
    }

    function AddData() {
        if ($('#NewProjectName').val() == "") {
            alert('Please enter New Project Name');
            return false;
        }
        //Serialize the form data.
        var valdata = $("#ProjectForm").serialize();
        //to get alert popup
        $.ajax({
            url: '@Url.Action("SaveProject","ProjectMaster")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data.Result.includes('Error')) {
                    alert(data.Result);
                }
                else {
                    ShowSaveSuccess(data.Result);
                }
            },
            error: function (ex) {
                console.log(ex);
            }
        });
    }
    function SaveData() {

        if (ValidateForm() == false) {
            return false;
        }
            //Serialize the form datas.
            var valdata = $("#ProjectForm").serialize();
            //to get alert popup
            $.ajax({
                url: '@Url.Action("SaveProject","ProjectMaster")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data.Result.includes('Error')) {
                        alert(data.Result);
                    }
                    else {
                        ShowSaveSuccess(data.Result);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
        //ShowSaveSuccess();
        //$('#btnSave').prop('disabled', true);
    }

    function ValidateForm() {

	    var message = "";

        if ($('#ProjectName').val() == "")
        {
            message += 'Project Name' + '<br>';
        }
        if ($('#IsActive').val() == "") {
            message += 'IsActive' + '<br>';
        }
        if (message != "") {
            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {
            $('#errormessage').html('');
        }
        return true;
    }

   function LoadData() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetProject", "ProjectMaster")',
            dataType: 'json',
            data: { projectName: $('#ProjectName').val() },
            success: function (data) {
                if (data == 'Not Found') {
                    alert('Project Not found');
                }
                else {
                    $('#ProjectName').val(data.ProjectName);
                    $('#IsActive').val(data.IsActive);
                }

            },
            error: function (ex) {
                alert('Vendor Not Found');
                console.log(ex);
            }

        });
    }

    function CloneProject() {

        if ($('#ProjectName').val() == "") {
            $('#errormessage').html("* <b>Please enter/select a existing project name to copy from</b> <br><br>");
            return false;
        }
        else {
            $('#errormessage').html("");
        }

        let confirmAction = confirm("Are you sure you want to Copy the Project and associated PRs ?");
        if (confirmAction == false) {
            return false;
        }
            //Serialize the form datas.
            var valdata = $("#ProjectForm").serialize();
            //to get alert popup
            $.ajax({
                url: '@Url.Action("CloneProject","ProjectMaster")',
                type: "POST",
                dataType: 'json',
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                data: valdata,
                success: function (data) {
                    if (data.Result.includes('Error')) {
                        alert(data.Result);
                    }
                    else {
                        ShowSaveSuccess(data.Result);
                    }
                },
                error: function (ex) {
                    console.log(ex);
                }
            });
        //ShowSaveSuccess();
        //$('#btnSave').prop('disabled', true);
    }

    function UploadPR() {
        if ($('#ProjectName').val() == "") {
            alert('Please enter a existing project name.')
            $('#ProjectName').focus();
            return false;
        }
        var fileUpload = $("#PRFileUpload").get(0);
        var files = fileUpload.files;

        // Create FormData object
        var fileData = new FormData();

        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        // Adding one more key to FormData object
        fileData.append('projectname', $('#ProjectName').val());

        $.ajax({
            url: '/ProjectMaster/UploadPRFile',
            type: "POST",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: fileData,
            success: function (result) {

                alert(result);
            },
            error: function (err) {
                alert(err.statusText);
            }
        });
    }
</script>
<div class="container mt-4">

    <div class="card shadow-lg p-4">
        <h4 class="mb-4 text-primary">Project Management</h4>

        <form id="ProjectForm">

            <!-- ================= Existing Project ================= -->
            <div class="card custom-card mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-4">
                        <i class="glyphicon glyphicon-folder-open"></i>
                        Existing Project
                    </h5>

                    <div class="row align-items-end">

                        <div class="col-md-5">
                            <label class="form-label required">Project Name</label>
                            <div class="input-group">
                                <select class="form-control" id="ProjectName" name="ProjectName"></select>
                                <span class="input-group-btn">
                                    <button class="btn btn-info" type="button" onclick="LoadData();">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </button>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label required">Active</label>
                            <select class="form-control" name="IsActive" id="IsActive">
                                <option value="">--Select--</option>
                                <option value="yes">Yes</option>
                                <option value="no">No</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <button type="button"
                                    id="btnSave"
                                    class="btn btn-primary w-100"
                                    onclick="SaveData();">
                                Save Existing Project
                            </button>
                        </div>

                    </div>

                    <div id="message" class="text-success mt-3"></div>
                </div>
            </div>
            <br>

            <div class="row mt-4">

                <!-- ================= Add New Project ================= -->
                <div class="col-md-6">
                    <div class="card custom-card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-3 text-success">
                                <i class="glyphicon glyphicon-plus"></i>
                                Add New Project
                            </h5>

                            <div class="mb-3">
                                <label class="form-label">New Project Name</label>
                                <input type="text"
                                       id="NewProjectName"
                                       name="NewProjectName"
                                       placeholder="Enter new project name"
                                       class="form-control">
                            </div>

                            <button type="button"
                                    id="btnAdd"
                                    class="btn btn-success w-100"
                                    onclick="AddData();">
                                Save New Project
                            </button>
                        </div>
                    </div>
                </div>


                <!-- ================= Clone Project ================= -->
                <div class="col-md-6">
                    <div class="card custom-card h-100">
                        <div class="card-body">
                            <h5 class="card-title mb-3 text-warning">
                                <i class="glyphicon glyphicon-duplicate"></i>
                                Clone Project
                            </h5>

                            <div class="mb-3">
                                <label class="form-label">New Project Name</label>
                                <input type="text"
                                       id="CloneProjectName"
                                       name="CloneProjectName"
                                       placeholder="Enter cloned project name"
                                       class="form-control">
                            </div>

                            <button type="button"
                                    id="btnClone"
                                    class="btn btn-warning w-100"
                                    onclick="CloneProject();">
                                Copy Existing Project
                            </button>

                            <div class="alert alert-danger mt-3 small">
                                This will duplicate all PRs from the selected project.
                                PR Date and Required Date will default to today.
                            </div>
                        </div>
                    </div>
                </div>

            </div>



            <!-- ================= Bulk Upload ================= -->
            <div class="card custom-card mt-4">
                <div class="card-body">
                    <h5 class="card-title text-info mb-4">
                        <i class="glyphicon glyphicon-upload"></i>
                        Bulk PR Upload
                    </h5>

                    <div class="row align-items-end">

                        <div class="col-md-5">
                            <label class="form-label">Upload File</label>
                            <input type="file"
                                   id="PRFileUpload"
                                   name="PRFileUpload"
                                   class="form-control">
                        </div>

                        <div class="col-md-3">
                            <button type="button"
                                    id="btnFileUpload"
                                    class="btn btn-info w-100"
                                    onclick="UploadPR();">
                                Upload PRs
                            </button>
                        </div>

                        <div class="col-md-4">
                            <a class="btn btn-outline-secondary w-100"
                               href="@Url.Action("GetSampleExcel", "ProjectMaster")">
                                Download Template
                            </a>
                        </div>

                    </div>

                </div>
            </div>


            <div id="errormessage" class="alert alert-danger mt-4 d-none"></div>

        </form>
    </div>

</div>

