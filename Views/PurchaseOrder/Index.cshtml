@{
    ViewBag.Title = "Index";
    // Cache-bust ModernUI.css against its own last-write time, so a browser that already cached an
    // older copy (same URL every deploy otherwise) is forced to re-fetch it after any CSS edit,
    // instead of silently keeping stale styling until a manual hard refresh.
    var modernUiCssVersion = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/ModernUI.css")).Ticks;
}
<script src="~/Scripts/jquery-3.4.1.js"></script>
<link href="~/Scripts/jquery-ui-1.12.1.min.css" rel="stylesheet" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">*@
<link href="~/Content/Purchase.css" rel="stylesheet" />
<link href="~/Content/ModernUI.css?v=@modernUiCssVersion" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>*@
<script src="~/Scripts/jquery.validate.min-1.19.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>*@

<script src="~/Scripts/form-validation.js"></script>

<style>
	.popup {
		display: none;
		position: fixed; /* Changed to fixed to ensure it stays in the same position */
		top: 50%; /* Center vertically */
		left: 50%; /* Center horizontally */
		transform: translate(-50%, -50%); /* Translate to adjust for the popup's own dimensions */
		background-color: #fff;
		border: 1px solid #000;
		padding: 20px;
		width: 300px;
		height: 200px;
		z-index: 1000; /* Ensure it's on top */
	}
	.popup-content {
		padding: 30px; /* Adjust the value as needed */
	}
</style>

<script>
    var projectArr = [];

    function ExportPRsForPO() {
        var url = '@Url.Action("WritePRsForPOItemToExcel", "Report")';
        var poNumber = $('#PONumber').val();
        window.location.href = url + '?PONumber=' + poNumber;
    }

    function LoadData() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("POGet","PurchaseOrder")',
            dataType: 'json',
            data: { PONumber: $('#PONumber').val() },
            success: function (data) {
                if (data == 'Not Found') {
                    alert('PO Not found');
                }
                else {
                    if (data.IsApproved == 'yes') {
                        $('#ApprovalStatus').text("Approved");
                        $('#ApprovalStatus').css("color", "green");
                    }
                    else if (data.IsApprovalRequested == 'yes') {
                         $('#ApprovalStatus').text("Pending");
                    }
                    else {
                          $('#ApprovalStatus').text("Not Applied");
                    }
                    $('#PONumber').val(data.PONumber);
                    $('#Company').val(data.Company);
                    $('#PODate').val(data.PODate);
                    $('#ProjectRef').val(data.ProjectRef);
                    $('#Vendor').val(data.Vendor);
                    $('#QuoteRef').val(data.QuoteRef);
                    $('#HSNNo').val(data.HSNNo);
                    $('#DeliveryRequiredBy').val(data.DeliveryRequiredBy);
                    $('#DeliveryInstructions').val(data.DeliveryInstructions);
                    $('#DeliveryRequiredAt').val(data.DeliveryRequiredAt);
                    $('#TransportationCharges').val(data.TransportationCharges);
                    $('#PaymentTerms').val(data.PaymentTerms);
                    $('#PORemarks').val(data.PORemarks);
                    $('#PRTable tbody').empty();
                    projectArr = data.AllProjects ? data.AllProjects.split(',').filter(function (p) { return p !== ''; }) : [];
                    $('#finalTotal').text(data.POAmount);
                    $('#BillAmount').val(data.BillAmount);
                    $('#BillNoAndDate').val(data.BillNoAndDate);
                    $('#PaymentDate').val(data.PaymentDate);

                      var isTotalChecked = data.DisplayTotal == 'true' ? true : false;

                    if (isTotalChecked) {
                        $('#DisplayTotal').prop('checked', true);
                      } else {
                        $('#DisplayTotal').prop('checked', false);
                      }

                    var isDiscountChecked = data.DisplayDiscount == 'true' ? true : false;

                    if (isDiscountChecked) {
                        $('#DisplayDiscount').prop('checked', true);
                    } else {
                        $('#DisplayDiscount').prop('checked', false);
                    }

                    var purchaseOrderItems = data.PurchaseOrderItems;
                    for (i = 0; i < purchaseOrderItems.length; i++) {
                        PREditTable(purchaseOrderItems[i].ProjectName, purchaseOrderItems[i].PRNumber,
                            purchaseOrderItems[i].ItemName,
                            purchaseOrderItems[i].ItemSize,
                            purchaseOrderItems[i].Qty,
                            purchaseOrderItems[i].Unit, purchaseOrderItems[i].POQuantity, purchaseOrderItems[i].Rate,
							purchaseOrderItems[i].Discount, purchaseOrderItems[i].Drawing);
                    }
                    RenumberPRTable();
                    RenderProjectChips();
                }

            },
            error: function (ex) {
                alert('PO Not Found');
                console.log(ex);
            }

        });
    }
    function CalculateTotals() {
        var total = 0;
        var purchaseOrderItems = FillItemsArray();
        if (purchaseOrderItems == null || purchaseOrderItems.length == 0)
        {
            $('#finalTotal').text('0.00');
            $('#POAmount').val('');
            return 0;
        }

        var finalQty = 0;
        for (i = 0; i < purchaseOrderItems.length; i++) {
            var rate = purchaseOrderItems[i].Rate;
            var discount = 0;
            finalQty = purchaseOrderItems[i].Qty;
            if (purchaseOrderItems[i].POQuantity != null && purchaseOrderItems[i].POQuantity > 0) {
                finalQty = purchaseOrderItems[i].POQuantity;
            }
            if (purchaseOrderItems[i].Discount != null && purchaseOrderItems[i].Discount != '') {
                discount = purchaseOrderItems[i].Discount;
            }
            total = total + ((finalQty * rate) * ((100 - discount)/100));
        }
        total = Math.round(total);
        $('#finalTotal').text(total);
        $('#POAmount').val(total);
        return total;

    }

    function PrintPO() {
        if ($('#PONumber').val() == 'undefined' || $('#PONumber').val() == '') {
            alert('Please Enter a valid PO Number');
            return;
        }
        var url = '@Url.Action("PrintPO", "PurchaseOrder",new { PONumber = "po_number"})';
        url = url.replace("po_number", $('#PONumber').val());
        window.open(url,"_blank","top=20, left=20, scrollbars=yes width=800, height=500");
    }

    function ClearScreen() {
        $('#PONumber').val('');
        $('#Company').val($("#Company option:first").val());

        $('#PODate').val('');
        $('#ProjectRef').val($("#ProjectRef option:first").val());
        $('#Vendor').val($("#Vendor option:first").val());
        $('#QuoteRef').val('');
        $('#HSNNo').val('');
        $('#DeliveryRequiredBy').val('');
        $('#DeliveryInstructions').val('');
        $('#DeliveryRequiredAt').val('');
        $('#TransportationCharges').val('');
        $('#PaymentTerms').val($("#PaymentTerms option:first").val());
        $('#PORemarks').val('');
        $('#PRTable tbody').empty();
        $('#AllProjects').val('');
        projectArr = [];
        RenderProjectChips();
        $('#finalTotal').text('0.00');
        $('#POAmount').val('');
    }

    function GeneratePONumber() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GenerateNewPONumber", "PurchaseOrder")',
            dataType: 'json',
            success: function (data) {
                if (data == null || data == '' || data.indexOf('Error') == 0) {
                    alert(data);
                    return;
                }
                ClearScreen();
                $('#PONumber').val(data);
            },
            error: function (ex) {
                alert('Unable to generate a new PO Number');
                console.log(ex);
            }
        });
    }

    // Renumbers the "#" column so every row shows its current position - called after any
    // insert or removal, rather than trying to compute the right number at insert time.
    function RenumberPRTable() {
        $('#PRTable tbody tr').each(function (idx) {
            $(this).find('td').eq(0).text(idx + 1);
        });
    }

    function PRAddToTable(Project, PRNumber, Item, Qty, Unit, ItemSize, Drawing) {

		var encodedDrawing = Drawing ? Drawing.replace(/'/g, "\\'") : "";
		var linkColumn = Drawing ? "<a href='#' onclick=\"ShowPopUp('" + encodedDrawing + "')\"><span class='glyphicon glyphicon-plus'></span></a>" : "";

    // Append product to the table
        $("#PRTable tbody").append("<tr>" +
			"<td class='row-num'></td>" +
			"<td>" + linkColumn + "</td>" +  // Add button only if Drawing has a value
        "<td>" + Project + "</td>" +
        "<td>" + PRNumber + "</td>" +
        "<td>" + Item + "</td>" +
        "<td>" + ItemSize + "</td>" +
        "<td>" + Unit + "</td>" +
        "<td>" + Qty + "</td>" +
        "<td><input type='number' step='.01' style='width: 7em' id='" + "POQty_" + PRNumber + "'/>" + "</td>" +
        "<td><input type='number' style='width: 7em' size='8' id='" + "Rate_" + PRNumber + "'/>" + "</td>" +
        "<td><input type='number' style='width: 7em' size='8' id='" + "Discount_" + PRNumber + "'/>" + "</td>" +
        "<td><input type='checkbox' id='" + "PRChk_" + PRNumber + "'/>" + "</td>" +
        "</tr>");
    }

    function PREditTable(Project, PRNumber, Item, ItemSize, Qty, Unit, POQty, Rate, Discount, Drawing) {

		var encodedDrawing = Drawing ? Drawing.replace(/'/g, "\\'") : "";
		var linkColumn = Drawing ? "<a href='#' onclick=\"ShowPopUp('" + encodedDrawing + "')\"><span class='glyphicon glyphicon-plus'></span></a>" : "";

        $("#PRTable tbody").append("<tr>" +
			"<td class='row-num'></td>" +
			"<td>" + linkColumn + "</td>" +
            "<td>" + Project + "</td>" +
            "<td>" + PRNumber + "</td>" +
            "<td>" + Item + "</td>" +
            "<td>" + ItemSize + "</td>" +
            "<td>" + Unit + "</td>" +
            "<td>" + Qty + "</td>" +
            "<td><input type='number' style='width: 7em' value='" + POQty + "' id='" + "POQty_" + PRNumber + "'/>" + "</td>" +
            "<td><input type='number' style='width: 7em' value='" + Rate + "' id='" + "Rate_" + PRNumber + "'/>" + "</td>" +
            "<td><input type='number' style='width: 7em' value='" + Discount + "' id='" + "Discount_" + PRNumber + "'/>" + "</td>" +
            "<td><input type='checkbox' Checked='Checked' id='" + "PRChk_" + PRNumber + "'/>" + "</td>" +
            "</tr>");
    }

    function GetPRs() {
        var projectSelected = $("#ProjectRef").val();

        if (projectSelected == null || projectSelected == '') {
            alert('Please select a Project Ref');
            return;
        }

        if (projectArr.length > 0 && projectArr.includes(projectSelected) == true) {
            alert('Project Already Selected');
            return;
        }

         $.ajax({
             type: "GET",
             url: '@Url.Action("GetPRs","PurchaseOrder")',
             data: { project: $("#ProjectRef").val() },
             success: function (data) {
                 if (data == null || data.length == 0) {
                     alert("No Active PR Records");
                 }
                 else {
                         projectArr.push(projectSelected);

                     for (var i = 0; i < data.length; i++) {
                         PRAddToTable(data[i].ProjectRefDropdown, data[i].PRNo, data[i].ItemDropdown, data[i].Quantity, data[i].Unit,data[i].ItemSize,data[i].Drawing);
                     }
                     RenumberPRTable();
                     RenderProjectChips();
                     PRData = data;
                 }
             }
         });
    }

    // Renders the "Projects Loaded" chip list from projectArr, and keeps the hidden #AllProjects
    // field (submitted with the form) in sync with it.
    function RenderProjectChips() {
        var container = $('#ProjectsLoadedDisplay');
        container.empty();
        for (var i = 0; i < projectArr.length; i++) {
            var project = projectArr[i];
            var chip = $('<span class="ui-project-chip"></span>').text(project);
            var removeIcon = $('<span class="ui-project-chip-remove" title="Remove this project">&times;</span>');
            removeIcon.on('click', (function (p) {
                return function () { RemoveProject(p); };
            })(project));
            chip.append(removeIcon);
            container.append(chip);
        }
        $('#AllProjects').val(projectArr.join());
    }

    // Removing a project's chip drops that project AND every PR row it loaded into the table below
    // - risky (it can wipe out rate/discount/qty a user already entered), so this always confirms
    // first.
    function RemoveProject(project) {
        var res = confirm("Are you sure? This will remove Project '" + project + "' and all its PR rows from the table below.");
        if (res == false) {
            return;
        }

        $('#PRTable tbody tr').each(function () {
            var row = $(this);
            if (row.find('td').eq(2).text() == project) {
                row.remove();
            }
        });

        RenumberPRTable();
        projectArr = projectArr.filter(function (p) { return p !== project; });
        RenderProjectChips();
        CalculateTotals();
    }

    $(document).ready(function () {

		$('.button').on('click', function (event) {
			var buttonOffset = $(this).offset(); // Get the button's position
			var popup = $('.popup'); // Select the popup

			// Set the popup's position relative to the button
			popup.css({
				'top': buttonOffset.top + $(this).outerHeight() + 'px', // Place it just below the button
				'left': buttonOffset.left + 'px', // Align it with the button's left side
				'display': 'block' // Make it visible
			});
		});


        // Auto-recalculate the Total Amount whenever PO Qty, Rate or Discount is edited, instead of
        // requiring an explicit "Calculate Total" click every time. Both "change" and "blur" are
        // bound (not just blur) because blur alone was occasionally missing the very first edit on
        // a freshly-added row - "change" fires reliably as soon as the value commits (including via
        // the number input's spinner arrows), so the total is never left stale.
        $('#PRTable').on('blur change', 'input[id^="POQty_"], input[id^="Rate_"], input[id^="Discount_"]', function () {
            CalculateTotals();
        });

        $.ajax({
                   type: "GET",
                   url: '@Url.Action("GetVendorNames","PurchaseOrder")',
                   success: function (data) {
                       var s = '<option value="">Please Select</option>';
                       for (var i = 0; i < data.length; i++) {
                           s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                       }
                       $("#Vendor").html(s);
                   }
        });

        $.ajax({
                   type: "GET",
                   url: '@Url.Action("GetPaymentTerms","PurchaseOrder")',
                   success: function (data) {
                       var s = '<option value="">Please Select</option>';
                       for (var i = 0; i < data.length; i++) {
                           s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                       }
                       $("#PaymentTerms").html(s);
                   }
        });


        $.ajax({
            type: "GET",
              url: '@Url.Action("GetProjectNames","PurchaseOrder")',
              data: {
                 search: $("#ProjectRef").val(),
                 projects: projectArr
              },
               success: function (data) {
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   $("#ProjectRef").html(s);
               }
        });

        $.ajax({
            type: "GET",
              url: '@Url.Action("GetCompanyNames","PurchaseOrder")',
               success: function (data) {
                   var s = '<option value="">--Select--</option>';
                   for (var i = 0; i < data.length; i++) {
                       s += '<option value="' + data[i] + '">' + data[i] + '</option>';
                   }
                   $("#Company").html(s);
               }
        });



        $('#PODate').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#DeliveryRequiredBy').datepicker({
            dateFormat: "dd-mm-yy",
        });
        $('#PaymentDate').datepicker({
            dateFormat: "dd-mm-yy",
        });
    });

    function ShowPopUp(drawing) {
		$('#popupTable tbody').empty();
		$('#popupTable tbody').append(
			`<tr>
                <td style="padding:5px;">${drawing}</td>
             </tr>`
		);
		// Show the popup
		$('.popup').fadeIn();   
		$('body').css('overflow', 'hidden');
        }


	function ClosePopup() {
        $('.popup').fadeOut(); // Hide the popup with a fade-out effect
		$('body').css('overflow', 'auto');
	}

    function ValidateForm() {

        var valid = true;
	    var message = "";

        if ($('#PONumber').val() == "")
        {
            message += 'Purchase Order Number' + '<br>';
        }
        if ($('#Company').val() == "")
        {
            message += 'Company' + '<br>';
        }
        if ($('#PODate').val() == "")
        {
            message += 'PO Date' + '<br>';
        }
        if ($('#ProjectRef').val()=="")
        {
            message += 'Project Ref' + '<br>';
        }
        if ($('#Vendor').val() == "")
        {
            message += 'Vendor' + '<br>';
        }
        if ($('#QuoteRef').val() == "")
        {
            message += 'Quote ref' + '<br>';
        }
        //if ($('#HSNNo').val() == "")
        //{
        //    message += 'HSN No' + '<br>';
        //}
        if ($('#DeliveryRequiredBy').val() == "")
        {
            message += 'Date Required By' + '<br>';
        }
        if ($('#DeliveryInstructions').val() == "")
        {
            message += 'Delivery Instructions' + '<br>';
        }
        if ($('#DeliveryRequiredAt').val() == "")
        {
            message += 'Date Required At' + '<br>';
        }
        if ($('#TransportationCharges').val() == "")
        {
            message += 'Transportation Charges' + '<br>';
        }
        if ($('#PaymentTerms').val() == "")
        {
            message += 'Payment Terms' + '<br>';
        }
        var arr = FillItemsArray();
        if (arr.length == 0)
        {
            message += 'Items table is blank Or none of checkboxes selected' + '<br>';
        }

        var msg = CheckItemTable();
        if (msg != 'true') {
            message += msg + '<br>';
        }
        if (message != "") {

            $('#errormessage').html("* <b>Please fill below values</b> <br><br>" + message + "<br>");
            return false;
        }
        else {

            $('#errormessage').html();
        }
        return true;
    }

    function SaveData() {
        // Always (re)calculate the total first, so it's never missed/stale regardless of what
        // the user did or didn't blur/change before clicking Save All.
        CalculateTotals();

        //Serialize the form datas.
        if (ValidateForm() == false) { return false; }

        var valdata = $("#POForm").serialize();
        var POSaveSuccess = true;
        // Save PO
        $.ajax({
            url: '@Url.Action("POSave","PurchaseOrder")',
            type: "POST",
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            data: valdata,
            success: function (data) {
                if (data != 'Success') {
                    alert(data);
                }
                else {
                    //alert('Inside POItemSave Else');
                    POItemsSave();
                }
            },
            failure: function (response) {
                alert("Error");
            }
        });
        if (POSaveSuccess == false) {
            return false;
        }

    }

    function CheckItemTable() {
        var rateEntered = true;
        $("#PRTable TBODY TR").each(function () {
            var row = $(this);
            var PurchaseOrderItem = {};
            PurchaseOrderItem.PONumber = $('#PONumber').val();
            PurchaseOrderItem.PRNumber = row.find("TD").eq(3).html();
            PurchaseOrderItem.Rate = row.find("#Rate_" + PurchaseOrderItem.PRNumber).val();
            PurchaseOrderItem.Discount = row.find("#Discount_" + PurchaseOrderItem.PRNumber).val();
            PurchaseOrderItem.POQuantity = row.find("#POQty_" + PurchaseOrderItem.PRNumber).val();
            var ch = row.find("#PRChk_" + PurchaseOrderItem.PRNumber).is(':checked');
            if (ch == true) {
                if (PurchaseOrderItem.Rate == null || PurchaseOrderItem.Rate == '') {
                        rateEntered = false;
                    }
                }
        });
        if (rateEntered == false) {
            return 'Please enter Rate when checkbox marked';
        }
        else {
            return 'true';
        }
    }

    function FillItemsArray() {
        var purchaseOrderItems = new Array();

        $("#PRTable TBODY TR").each(function () {
            var row = $(this);
            var PurchaseOrderItem = {};
            PurchaseOrderItem.PONumber = $('#PONumber').val();
            PurchaseOrderItem.PRNumber = row.find("TD").eq(3).html();
            PurchaseOrderItem.Qty = row.find("TD").eq(7).html();
            PurchaseOrderItem.Rate = row.find("#Rate_" + PurchaseOrderItem.PRNumber).val();
            PurchaseOrderItem.Discount = row.find("#Discount_" + PurchaseOrderItem.PRNumber).val();
            PurchaseOrderItem.POQuantity = row.find("#POQty_" + PurchaseOrderItem.PRNumber).val();
            var ch = row.find("#PRChk_" + PurchaseOrderItem.PRNumber).is(':checked');
            if (ch == true) {
                    purchaseOrderItems.push(PurchaseOrderItem);
                }
        });
        return purchaseOrderItems;
    }

    function POItemsSave() {

        var purchaseOrderItems = FillItemsArray();

        if (purchaseOrderItems.length > 0) {
            console.log(purchaseOrderItems);
            purchaseOrderItems = JSON.stringify({ 'purchaseOrderItems': purchaseOrderItems });
            //Save PO Items
            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: '@Url.Action("POItemSave","PurchaseOrder")',
                data: purchaseOrderItems,
                success: function () {
                    $('#errormessage').html("");
                    $("#message").text('Record Saved Successfully');
                    alert('Record Saved Successfully');
                    setTimeout(function() { $("#message").hide(); }, 5000);
                },
                failure: function (response) {
                    alert("Error");
                }
            });
        }
    }

    function RemovePO() {
        var poNumber = $('#PONumber').val();

        var res = confirm("Are you sure to remove the PO and release all associated PRs.");
        if (res == false) {
            return 0;
        }

         $.ajax({
             type: "GET",
             url: '@Url.Action("RemovePO","PurchaseOrder")',
             data: { poNumber: $('#PONumber').val(), poAdminCode: $('#POAdminCode').val() },
             success: function (data) {
                 if (data.includes('Error') == true) {
                     alert(data);
                 }
                 else {
                     alert('PO Record Successfully Removed and PRs Released');
                     ClearScreen();
                 }
             }
         });

    }

    function ApprovePO() {
        var poNumber = $('#PONumber').val();

        var res = confirm("Please confirm your approval action.");
        if (res == false) {
            return 0;
        }

         $.ajax({
             type: "GET",
             url: '@Url.Action("ApprovePO","PurchaseOrder")',
             data: { poNumber: $('#PONumber').val(), poApproverCode: $('#POApproverCode').val() },
             success: function (data) {
                 if (data.includes('Error') == true) {
                     alert(data);
                 }
                 else {
                     alert('PO Successfully Approved.');
                     $('#ApprovalStatus').text("Approved");
                     $('#ApprovalStatus').css("color", "green");
                 }
             }
         });

    }
    function RequestApproval() {
        var poNumber = $('#PONumber').val();
        if (poNumber == null || poNumber == '') {
            alert('Please enter a PO Number for Approval');
            return false;
        }
         $.ajax({
             type: "GET",
             url: '@Url.Action("SubmitForApproval", "PurchaseOrder")',
             data: { poNumber: $('#PONumber').val()},
             success: function (data) {
                 if (data.includes('Error') == true) {
                     alert(data);
                 }
                 else {
                     alert('PO Approval Requested Successfully.');
                     $('#ApprovalStatus').text("Pending");
                 }
             }
         });

    }
</script>
<div class="container mt-4 ui-modern">

    <div class="ui-page-title">
        <span class="glyphicon glyphicon-shopping-cart"></span>Purchase Order Details
    </div>

    <form role="form" name="POForm" id="POForm" autocomplete="off">

        <!-- ================= Search / Manage PO ================= -->
        <div class="ui-card">
            <div class="ui-card-title"><span class="glyphicon glyphicon-search"></span>Find / Create Purchase Order</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="PONumber" class="form-label required">Purchase Order Number</label>
                        <div class="input-group">
                            <input type="text" id="PONumber" name="PONumber" autocomplete="off" placeholder="Purchase Order Number" class="form-control ui-input-md" autofocus>
                            <span class="input-group-btn">
                                <button class="btn btn-info" type="button" onclick="LoadData();" title="Load this PO">
                                    <span class="glyphicon glyphicon-search"></span>Load
                                </button>
                                <button class="btn btn-default" type="button" onclick="PrintPO();" title="Print PO">
                                    <span class="glyphicon glyphicon-print"></span>
                                </button>
                                <button class="btn btn-default" type="button" onclick="ExportPRsForPO();" title="Export PRs for PO to Excel">
